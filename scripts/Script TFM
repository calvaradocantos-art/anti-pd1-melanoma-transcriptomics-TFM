############################################################
# 15.11. GSEA SOBRE EL TRANSCRIPTOMA COMPLETO
#
# El análisis de sobrerrepresentación (ORA) utiliza únicamente
# los genes que superan los umbrales definidos para DEGs.
#
# Como complemento, GSEA evalúa si conjuntos funcionales
# presentan una señal coordinada a lo largo de todo el
# transcriptoma, incluso cuando genes individuales no alcanzan
# los criterios de significación utilizados para definir DEGs.
#
# Para construir el ranking se utiliza el estadístico de Wald
# de DESeq2 correspondiente al contraste:
#
# Responder vs NonResponder.
#
# Un valor positivo indica asociación con Respondedores.
# Un valor negativo indica asociación con NonRespondedores.
############################################################


# ----------------------------------------------------------
# 15.11.1. Construir ranking génico
# ----------------------------------------------------------

gsea_rank <- res_raw_df %>%
  filter(
    !is.na(stat),
    !is.na(ENTREZID),
    ENTREZID != ""
  ) %>%
  distinct(
    ENTREZID,
    .keep_all = TRUE
  ) %>%
  arrange(
    desc(stat)
  )


ranked_entrez <- gsea_rank$stat

names(ranked_entrez) <-
  gsea_rank$ENTREZID

ranked_entrez <- sort(
  ranked_entrez,
  decreasing = TRUE
)


stopifnot(
  all(
    is.finite(ranked_entrez)
  )
)


cat(
  "\nNúmero de genes incluidos en el ranking GSEA:",
  length(ranked_entrez),
  "\n"
)

############################################################
# 15.11.2. GSEA - Gene Ontology Biological Process
############################################################

gsea_go <- gseGO(
  geneList = ranked_entrez,
  OrgDb = org.Hs.eg.db,
  keyType = "ENTREZID",
  ont = "BP",
  minGSSize = 15,
  maxGSSize = 500,
  pvalueCutoff = 1,
  pAdjustMethod = "BH",
  eps = 0,
  verbose = FALSE,
  seed = TRUE
)


gsea_go_df <- as.data.frame(
  gsea_go
)

# ----------------------------------------------------------
# 15.11.2.1. Seleccionar términos significativos
#
# Se consideran significativos aquellos con:
# p.adjust < 0.05
#
# El filtrado se realiza DESPUÉS de ejecutar GSEA para
# conservar y documentar la tabla completa de resultados.
# ----------------------------------------------------------

gsea_go_significant <- gsea_go_df %>%
  filter(
    !is.na(p.adjust),
    p.adjust < 0.05
  )


cat(
  "\nNúmero de términos GO-BP significativos en GSEA:",
  nrow(gsea_go_significant),
  "\n"
)


# Mostrar resultados significativos
if (nrow(gsea_go_significant) > 0) {
  
  print(
    gsea_go_significant %>%
      arrange(p.adjust) %>%
      head(20)
  )
  
} else {
  
  cat(
    "\nNo se identificaron términos GO-BP significativos ",
    "con p.adjust < 0.05.\n"
  )
}


# Guardar TODOS los resultados
write.csv(
  gsea_go_df,
  "GSEA_GO_BP_GSE91061.csv",
  row.names = FALSE
)


# Guardar únicamente los significativos
write.csv(
  gsea_go_significant,
  "GSEA_GO_BP_significativos_GSE91061.csv",
  row.names = FALSE
)

# ============================================================
# FIGURA GSEA GO-BP – PROCESOS REPRESENTATIVOS
# ============================================================

go_selected <- gsea_go_significant %>%
  filter(
    Description %in% c(
      "adaptive immune response",
      "lymphocyte differentiation",
      "antigen receptor-mediated signaling pathway",
      "regulation of T cell activation",
      "B cell activation",
      "positive regulation of lymphocyte activation",
      "leukocyte cell-cell adhesion",
      "T cell differentiation involved in immune response",
      "positive regulation of T cell activation",
      "alpha-beta T cell activation"
    )
  ) %>%
  arrange(NES)

# Comprobar términos seleccionados
go_selected %>%
  select(
    ID,
    Description,
    setSize,
    NES,
    pvalue,
    p.adjust
  )

# Gráfico
ggplot(
  go_selected,
  aes(
    x = NES,
    y = reorder(Description, NES)
  )
) +
  geom_point(
    aes(
      size = setSize,
      color = -log10(p.adjust)
    )
  ) +
  labs(
    title = "Procesos biológicos enriquecidos asociados con la respuesta",
    subtitle = "GSEA GO-BP – GSE91061",
    x = "NES",
    y = NULL,
    size = "Tamaño del conjunto",
    color = expression(-log[10](p[ajustado]))
  ) +
  theme_minimal() +
  theme(
    plot.title = element_text(face = "bold"),
    axis.text.y = element_text(size = 9)
  )

