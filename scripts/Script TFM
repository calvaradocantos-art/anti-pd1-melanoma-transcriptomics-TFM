# 15.1. DEFINIR UNIVERSO DE GENES
# ----------------------------------------------------------

gene_universe <- unique(
  as.character(
    rownames(counts_filt)
  )
)


# Eliminar posibles identificadores vacíos
gene_universe <- gene_universe[
  !is.na(gene_universe) &
    gene_universe != ""
]


cat(
  "\nNúmero de genes utilizados como universo:",
  length(gene_universe),
  "\n"
)


