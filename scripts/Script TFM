    "Melanoma"
  ),
  
  Tratamiento = c(
    "Nivolumab",
    "Pembrolizumab",
    "Nivolumab / Pembrolizumab"
  ),
  
  Tipo_dato = c(
    "RNA-seq raw counts",
    "RNA-seq FPKM",
    "RNA-seq FPKM"
  ),
  
  Momento_muestreo = c(
    "Pretratamiento",
    "Baseline",
    "Pretratamiento"
  ),
  
  Definicion_respuesta = c(
    "CR/PR vs PD",
    "CR/PR vs PD",
    "CR/PR vs PD (principal); CR/PR vs SD/PD (sensibilidad)"
  ),
  
  Unidad_analitica = c(
    "Paciente",
    "Paciente",
    "Paciente"
  ),
  
  Manejo_replicas = c(
    "Una muestra Pre por paciente",
    "Biopsias múltiples agregadas a nivel de paciente",
    "Una muestra por paciente"
  ),
  
  stringsAsFactors = FALSE
)


cat(
  "\n========================================\n"
)

cat(
  "COMPARABILIDAD ENTRE COHORTES\n"
)

cat(
  "========================================\n\n"
)


print(
  dataset_comparison
)


# Exportar tabla para documentación del TFM

write.csv(
  dataset_comparison,
  "comparabilidad_cohortes_TFM.csv",
  row.names = FALSE
)


############################################################
# 20. ARMONIZACIÓN DE GSE91061 Y GSE78220
#
# GSE91061 utiliza Entrez IDs y posteriormente se anotó SYMBOL.
# GSE78220 se armonizará con GSE91061 mediante SYMBOL
# para evaluar reproducibilidad direccional y priorizar candidatos.
#
# NO se fusionarán ambas matrices debido a:
#
# - diferente estudio
# - diferente procesamiento
# - diferentes unidades
#
# La comparabilidad se evaluará a nivel de genes candidatos.
############################################################


# ----------------------------------------------------------
# 20.1. Genes candidatos del descubrimiento
# ----------------------------------------------------------

candidate_genes <- deg %>%
  filter(
    !is.na(SYMBOL)
  ) %>%
  distinct(
    SYMBOL,
    .keep_all = TRUE
  )


cat(
  "\nDEGs con símbolo génico disponibles para evaluación en GSE78220:",
  nrow(candidate_genes),
  "\n"
)


# ----------------------------------------------------------
# 20.2. Genes presentes en GSE78220
# ----------------------------------------------------------

candidate_genes <- candidate_genes %>%
  mutate(
    present_in_evaluation =
      SYMBOL %in%
      rownames(log_fpkm_patient)
  )


cat(
  "\nGenes candidatos presentes en GSE78220:",
  sum(candidate_genes$present_in_evaluation),
  "\n"
)


candidate_eval <- candidate_genes %>%
  filter(
    present_in_evaluation
  )



############################################################
# 21. EVALUACIÓN DE REPRODUCIBILIDAD DE GENES CANDIDATOS
#
# La evaluación se realizará a nivel de paciente.
#
# Se compara la expresión entre Respondedores y
# NonRespondedores mediante prueba no paramétrica de Wilcoxon.
#
# El objetivo no es realizar una validación confirmatoria,
# sino evaluar:
# - dirección del efecto
# - consistencia entre cohortes
# - evidencia estadística exploratoria
############################################################


# ----------------------------------------------------------
# 21.1. Función de evaluación por gen
# ----------------------------------------------------------

evaluate_gene <- function(gene_symbol) {
  
  # Extraer expresión del gen a nivel de paciente
  gene_values <- log_fpkm_patient[
    gene_symbol,
    ,
    drop = TRUE
  ]
  
  # Construir tabla de expresión + información clínica
  tmp <- data.frame(
    biological_patient_id = names(gene_values),
    expression = as.numeric(gene_values)
  ) %>%
    left_join(
      meta_eval_patient,
      by = "biological_patient_id"
    ) %>%
    filter(
      !is.na(response_group),
      !is.na(expression)
    )
  
  
  # --------------------------------------------------------
  # Separar grupos clínicos
  # --------------------------------------------------------
  
  responder_values <- tmp$expression[
    tmp$response_group == "Responder"
  ]
  
  nonresponder_values <- tmp$expression[
    tmp$response_group == "NonResponder"
  ]
  
  
  # --------------------------------------------------------
  # Comprobar que ambos grupos tengan suficientes datos
  # --------------------------------------------------------
  
  if (
    length(responder_values) < 2 ||
    length(nonresponder_values) < 2
  ) {
    
    return(
      data.frame(
        
        SYMBOL = gene_symbol,
        
        hl_estimate = NA_real_,
        hl_ci_lower = NA_real_,
        hl_ci_upper = NA_real_,
        
        reproducibility_p = NA_real_,
        
        median_responder = NA_real_,
        median_nonresponder = NA_real_,
        
        iqr_responder = NA_real_,
        iqr_nonresponder = NA_real_,
        
        mean_responder = NA_real_,
        mean_nonresponder = NA_real_,
        
        n_responder = length(responder_values),
        n_nonresponder = length(nonresponder_values)
      )
    )
  }

  # --------------------------------------------------------
  # Estadísticos descriptivos
  #
  # Debido al carácter no paramétrico del análisis,
  # la mediana y el rango intercuartílico (IQR) se utilizan
  # como estadísticos descriptivos principales.
  #
  # Las medias se conservan únicamente como información
  # descriptiva complementaria.
  # --------------------------------------------------------
  
  median_responder <- median(
    responder_values,
    na.rm = TRUE
  )
  
  median_nonresponder <- median(
    nonresponder_values,
    na.rm = TRUE
  )
  
  
  iqr_responder <- IQR(
    responder_values,
    na.rm = TRUE
  )
  
  iqr_nonresponder <- IQR(
    nonresponder_values,
    na.rm = TRUE
  )
  
  
  mean_responder <- mean(
    responder_values,
    na.rm = TRUE
  )
  
  mean_nonresponder <- mean(
    nonresponder_values,
    na.rm = TRUE
  )

  
  # --------------------------------------------------------
  # Prueba de Wilcoxon-Mann-Whitney y estimador
  # de Hodges-Lehmann
  #
  # responder_values se introduce como primer grupo y
  # nonresponder_values como segundo grupo.
  #
  # Por tanto:
  #
  # HL > 0  -> mayor expresión en Respondedores
  # HL < 0  -> mayor expresión en NonRespondedores
  #
  # Se obtiene además el intervalo de confianza del 95 %.
  # --------------------------------------------------------
  
  wilcox_res <- tryCatch(
    
    wilcox.test(
      responder_values,
      nonresponder_values,
      exact = FALSE,
      conf.int = TRUE,
      conf.level = 0.95
    ),
    
    error = function(e) NULL
  )
  
  # --------------------------------------------------------
  # Extraer p-valor, estimador de Hodges-Lehmann
  # e intervalo de confianza
  # --------------------------------------------------------
  
  if (!is.null(wilcox_res)) {
    
    reproducibility_p <- wilcox_res$p.value
    
    
    if (!is.null(wilcox_res$estimate)) {
      
      hl_estimate <- as.numeric(
        wilcox_res$estimate
      )
      
    } else {
      
      hl_estimate <- NA_real_
    }
    
    
    if (
      !is.null(wilcox_res$conf.int) &&
      length(wilcox_res$conf.int) == 2
    ) {
      
      hl_ci_lower <- as.numeric(
        wilcox_res$conf.int[1]
      )
      
      hl_ci_upper <- as.numeric(
        wilcox_res$conf.int[2]
      )
      
    } else {
      
      hl_ci_lower <- NA_real_
      hl_ci_upper <- NA_real_
    }
    
  } else {
    
    reproducibility_p <- NA_real_
    hl_estimate <- NA_real_
    hl_ci_lower <- NA_real_
    hl_ci_upper <- NA_real_
  }
  
  # --------------------------------------------------------
  # Resultado
  # --------------------------------------------------------
  
  data.frame(
    
    SYMBOL = gene_symbol,
    
    # Efecto principal no paramétrico
    hl_estimate = hl_estimate,
    hl_ci_lower = hl_ci_lower,
    hl_ci_upper = hl_ci_upper,
    
    # Evidencia estadística
    reproducibility_p = reproducibility_p,
    
    # Descriptivos principales
    median_responder = median_responder,
    median_nonresponder = median_nonresponder,
    
    iqr_responder = iqr_responder,
    iqr_nonresponder = iqr_nonresponder,
    
    # Descriptivos complementarios
    mean_responder = mean_responder,
    mean_nonresponder = mean_nonresponder,
    
    # Tamaño de grupos
    n_responder = length(
      responder_values
    ),
    
    n_nonresponder = length(
      nonresponder_values
    )
  )
}

############################################################
# 21.2. Aplicar evaluación a todos los candidatos
############################################################

reproducibility_results <- bind_rows(
  lapply(
    candidate_eval$SYMBOL,
    evaluate_gene
  )
)


# Corregir múltiples comparaciones

reproducibility_results$reproducibility_padj <-
   p.adjust(
    reproducibility_results$reproducibility_p,
    method = "BH"
  )


############################################################
# 21.3. Integrar descubrimiento y evaluación de
#       reproducibilidad
############################################################

candidate_reproducibility <- candidate_eval %>%
  left_join(
    reproducibility_results,
    by = "SYMBOL"
  ) %>%
  mutate(
    
    discovery_direction =
      case_when(
        
        log2FoldChange > 0 ~ "Responder",
        
        log2FoldChange < 0 ~ "NonResponder",
        
        TRUE ~ NA_character_
      ),
    
    
    reproducibility_direction =
      case_when(
        
        hl_estimate > 0 ~ "Responder",
        
        hl_estimate < 0 ~ "NonResponder",
        
        TRUE ~ NA_character_
      ),
    
    
    direction_consistent =
      discovery_direction ==
      reproducibility_direction
  )


cat(
  "\nGenes con dirección consistente entre cohortes:\n"
)

print(
  table(
    candidate_reproducibility$direction_consistent,
    useNA = "ifany"
  )
)


############################################################
# 22. PRIORIZACIÓN DE BIOMARCADORES CANDIDATOS
#
# Se conservan únicamente genes con dirección de efecto
# consistente entre GSE91061 y GSE78220.
#
# Dentro de este conjunto, los genes se ordenan según:
#
# 1. evidencia estadística exploratoria en GSE78220
#    (menor reproducibility_p);
#
# 2. significación en la cohorte de descubrimiento GSE91061
#    (menor padj).
#
# reproducibility_p < 0.05 se considera únicamente evidencia
# de apoyo y no un criterio de validación confirmatoria.
#
# La priorización integra:
#
# 1. Significación en GSE91061
# 2. Presencia en GSE78220
# 3. Dirección consistente entre cohortes
# 4. Evidencia estadística exploratoria en GSE78220
#
# IMPORTANTE:
# GSE78220 tiene un tamaño muestral reducido.
# Por ello, reproducibility_p < 0.05 se utilizará únicamente
# como criterio de apoyo exploratorio.
############################################################

prioritized_genes <- candidate_reproducibility %>%
  filter(
    direction_consistent == TRUE,
    !is.na(reproducibility_p)
  ) %>%
  mutate(
    reproducibility_support = reproducibility_p < 0.05
  ) %>%
  arrange(
    desc(reproducibility_support),
    reproducibility_p,
    padj
  )


cat(
  "\nNúmero de genes con dirección consistente:",
  nrow(prioritized_genes),
  "\n"
)

cat(
  "Genes con p < 0.05 en la cohorte de priorización:",
  sum(prioritized_genes$reproducibility_support, na.rm = TRUE),
  "\n"
)

# ----------------------------------------------------------
# 22.1. VISUALIZAR RANKING COMPLETO DE GENES PRIORIZADOS
#
# Los genes con dirección consistente se muestran ordenados
# según:
#
# 1. apoyo estadístico exploratorio en GSE78220
# 2. menor p de priorización
# 3. menor padj en GSE91061
#
# Esta tabla permite documentar de forma transparente
# la selección posterior de la firma génica candidata.
# ----------------------------------------------------------

cat(
  "\nRanking completo de genes priorizados:\n"
)

print(
  prioritized_genes %>%
    select(
      SYMBOL,
      
      # Descubrimiento GSE91061
      log2FoldChange,
      padj,
      
      # Efecto no paramétrico GSE78220
      hl_estimate,
      hl_ci_lower,
      hl_ci_upper,
      
      # Descriptivos principales
      median_responder,
      median_nonresponder,
      iqr_responder,
      iqr_nonresponder,
      
      # Descriptivos complementarios
      mean_responder,
      mean_nonresponder,
      
      # Inferencia
      reproducibility_p,
      reproducibility_padj,
      
      # Dirección entre cohortes
      discovery_direction,
      reproducibility_direction,
      direction_consistent,
      
      # Evidencia exploratoria
      reproducibility_support
    )
)


############################################################
# 23. SELECCIÓN DE FIRMA GÉNICA CANDIDATA
#
# Se selecciona un conjunto pequeño para reducir el riesgo
# de sobreajuste.
#
# La selección final deberá interpretarse junto con:
# - GO/KEGG
# - literatura científica
# - consistencia entre las dos cohortes
############################################################

genes_supported <- prioritized_genes %>%
  filter(reproducibility_support)


if (nrow(genes_supported) >= 2) {
  
  # Seleccionar como máximo 10 genes
  signature_genes <- genes_supported %>%
    slice_head(
      n = min(10, nrow(genes_supported))
    )
  
} else {
  
  warning(
    "Menos de dos genes presentan p < 0.05 en GSE78220. ",
    "Se construirá una firma exploratoria utilizando los genes ",
    "con dirección consistente entre cohortes y mejor evidencia ",
    "estadística exploratoria en GSE78220."
  )
  
  signature_genes <- prioritized_genes %>%
    slice_head(
      n = min(5, nrow(prioritized_genes))
    )
}


# Comprobar que exista al menos un gen candidato
stopifnot(nrow(signature_genes) > 0)


cat("\nGenes seleccionados para la firma candidata:\n")

print(
  signature_genes %>%
    select(
      SYMBOL,
      GENENAME,
      log2FoldChange,
      padj,
      hl_estimate,
      hl_ci_lower,
      hl_ci_upper,
      median_responder,
      median_nonresponder,
      iqr_responder,
      iqr_nonresponder,
      reproducibility_p,
      reproducibility_padj,
      direction_consistent
    )
)


############################################################
# 23.1. CONGELAR LA FIRMA ANTES DE LA EVALUACIÓN EXTERNA
#
# IMPORTANTE:
#
# A partir de este momento NO se modificará:
#
# - número de genes
# - identidad de los genes
# - dirección de los pesos
#
# utilizando información de GSE145996.
#
# Esto mantiene la independencia de la cohorte externa.
############################################################

final_signature <- signature_genes %>%
  filter(
    !is.na(SYMBOL)
  ) %>%
  distinct(
    SYMBOL,
    .keep_all = TRUE
  ) %>%
  mutate(
    weight = ifelse(
      log2FoldChange > 0,
      1,
      -1
    )
  )


cat("\nFirma congelada antes de evaluación externa:\n")

print(
  final_signature %>%
    select(
      SYMBOL,
      GENENAME,
      log2FoldChange,
      padj,
      hl_estimate,
      hl_ci_lower,
      hl_ci_upper,
      reproducibility_p,
      reproducibility_padj,
      weight
    )
)


# Guardar para trazabilidad
write.csv(
  final_signature,
  "firma_congelada_pre_evaluacion_externa.csv",
  row.names = FALSE
)

############################################################
# 23.2. ANOTACIÓN GÉNICA DE LOS GENES DE LA FIRMA
############################################################

signature_annotation <- AnnotationDbi::select(
  org.Hs.eg.db,
  keys = final_signature$SYMBOL,
  keytype = "SYMBOL",
  columns = c(
    "SYMBOL",
    "GENENAME",
    "ENTREZID"
  )
)

signature_annotation <- signature_annotation %>%
  distinct(
    SYMBOL,
    .keep_all = TRUE
  )

signature_biology <- final_signature %>%
  left_join(
    signature_annotation,
    by = "SYMBOL",
    suffix = c("", "_annotation")
  )

print(signature_biology)

write.csv(
  signature_biology,
  "anotacion_biologica_firma_genica.csv",
  row.names = FALSE
)

############################################################
# 24. CONGELACIÓN COMPLETA DE LOS PARÁMETROS DE LA FIRMA
#
# Antes de acceder a la cohorte externa GSE145996 se fijan:
#
# - genes de la firma
# - dirección/pesos
# - media de referencia
# - desviación estándar de referencia
#
# Las medias y desviaciones se calculan exclusivamente
# utilizando GSE78220.
#
# A partir del apartado 25 ningún componente de la firma
# podrá modificarse utilizando información de GSE145996.
############################################################

# Comprobar que todos los genes congelados existen
# en la matriz de referencia GSE78220

stopifnot(
  all(
    final_signature$SYMBOL %in%
      rownames(log_fpkm_patient)
  )
)

stopifnot(
  !anyDuplicated(
    final_signature$SYMBOL
  )
)

# ----------------------------------------------------------
# 24.1. Extraer genes de la firma en GSE78220
# ----------------------------------------------------------

signature_reference_matrix <- log_fpkm_patient[
  final_signature$SYMBOL,
  ,
  drop = FALSE
]

stopifnot(
  all(
    rownames(signature_reference_matrix) ==
      final_signature$SYMBOL
  )
)

# ----------------------------------------------------------
# 24.2. Calcular media y desviación estándar
#       exclusivamente con GSE78220
# ----------------------------------------------------------

signature_center <- rowMeans(
  signature_reference_matrix,
  na.rm = TRUE
)


signature_scale <- apply(
  signature_reference_matrix,
  1,
  sd,
  na.rm = TRUE
)


# Comprobar desviaciones
stopifnot(
  all(
    is.finite(signature_scale)
  )
)

stopifnot(
  all(
    signature_scale > 0
  )
)


# ----------------------------------------------------------
# 24.3. Definir pesos congelados
#
# +1 = asociado a respuesta
# -1 = asociado a no respuesta
# ----------------------------------------------------------

signature_weights <- ifelse(
  final_signature$log2FoldChange > 0,
  1,
  -1
)


names(signature_weights) <-
  final_signature$SYMBOL


# Reordenar todo exactamente igual
signature_center <-
  signature_center[
    final_signature$SYMBOL
  ]

signature_scale <-
  signature_scale[
    final_signature$SYMBOL
  ]

signature_weights <-
  signature_weights[
    final_signature$SYMBOL
  ]


cat(
  "\nParámetros de firma congelados correctamente.\n"
)


############################################################
