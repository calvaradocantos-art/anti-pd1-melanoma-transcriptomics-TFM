############################################################
# 16. DESCARGA Y CARACTERIZACIÓN DEL DATASET DE EVALUACIÓN
#     DE REPRODUCIBILIDAD Y PRIORIZACIÓN GSE78220
#
# GSE78220 contiene biopsias de melanoma obtenidas antes
# del tratamiento anti-PD-1.
#
# El archivo procesado disponible en GEO contiene valores FPKM.
#
# IMPORTANTE:
# Los FPKM NO se analizarán con DESeq2.
# Se utilizarán para evaluar la reproducibilidad de la
# dirección de efecto de los genes candidatos identificados
# previamente en GSE91061 y para su priorización exploratoria.
############################################################

# ----------------------------------------------------------
# 16.1. Descargar metadatos GEO
# ----------------------------------------------------------

gse_eval <- getGEO(
  "GSE78220",
  GSEMatrix = TRUE, getGPL = FALSE
)

eset_eval <- gse_eval[[1]]

meta_eval_raw <- pData(eset_eval)  


# Revisar estructura
cat("\nDimensiones de los metadatos GSE78220:\n")
print(dim(meta_eval_raw))

cat("\nColumnas disponibles:\n")
print(colnames(meta_eval_raw))


# ----------------------------------------------------------
# 16.2. Descargar archivos suplementarios
# ----------------------------------------------------------

getGEOSuppFiles(
  "GSE78220",
  makeDirectory = TRUE
)

cat("\nArchivos descargados de GSE78220:\n")

print(
  list.files(
    "GSE78220",
    recursive = TRUE
  )
)


############################################################
# 17. CONSTRUCCIÓN DE METADATOS CLÍNICOS DE LA COHORTE DE
#     PRIORIZACIÓN
#
# Se identificarán automáticamente las columnas correspondientes
# a:
#
# - paciente
# - respuesta anti-PD-1
# - tiempo de biopsia
# - tratamiento
#
# Esto evita depender de posiciones de columna fijas.
############################################################

# ----------------------------------------------------------
# 17.1. Buscar columnas relevantes
# ----------------------------------------------------------

patient_col_eval <- grep(
  "patient.*id",
  colnames(meta_eval_raw),
  value = TRUE,
  ignore.case = TRUE
)

response_col_eval <- grep(
  "anti.*pd.*1.*response|response.*pd",
  colnames(meta_eval_raw),
  value = TRUE,
  ignore.case = TRUE
)

biopsy_col_eval <- grep(
  "biopsy.*time",
  colnames(meta_eval_raw),
  value = TRUE,
  ignore.case = TRUE
)

treatment_col_eval <- grep(
  "^treatment",
  colnames(meta_eval_raw),
  value = TRUE,
  ignore.case = TRUE
)


cat("\nColumna de paciente encontrada:\n")
print(patient_col_eval)

cat("\nColumna de respuesta encontrada:\n")
print(response_col_eval)

cat("\nColumna de biopsia encontrada:\n")
print(biopsy_col_eval)

cat("\nColumna de tratamiento encontrada:\n")
print(treatment_col_eval)


# Debe encontrarse exactamente una columna de paciente
# y una columna de respuesta.

stopifnot(length(patient_col_eval) == 1)
stopifnot(length(response_col_eval) == 1)


# ----------------------------------------------------------
# 17.2. Construir metadata limpio
# ----------------------------------------------------------

meta_eval <- meta_eval_raw %>%
  as.data.frame() %>%
  mutate(
    
    sample_id = title,
    
    geo_accession_val = geo_accession,
    
    patient_id = as.character(
      .data[[patient_col_eval]]
    ),
    
    response_text = as.character(
      .data[[response_col_eval]]
    )
  )


# Si existe información de biopsia
if (length(biopsy_col_eval) == 1) {
  
  meta_eval$biopsy_time <-
    as.character(
      meta_eval[[biopsy_col_eval]]
    )
}


# Si existe información de tratamiento
if (length(treatment_col_eval) == 1) {
  
  meta_eval$treatment <-
    as.character(
      meta_eval[[treatment_col_eval]]
    )
}


# ----------------------------------------------------------
# 17.3. Revisar respuestas originales
# ----------------------------------------------------------

cat("\nRespuestas originales GSE78220:\n")

print(
  table(
    meta_eval$response_text,
    useNA = "ifany"
  )
)


############################################################
# 17.4. CONSTRUIR VARIABLE RESPONDER / NONRESPONDER
#
# GSE78220 presenta categorías clínicas como:
#
# Complete Response
# Partial Response
# Progressive Disease
#
# Para mantener la misma definición que en GSE91061:
#
# CR / PR -> Responder
# PD      -> NonResponder
#
# Si apareciera Stable Disease, se excluirá del análisis
# binario principal, igual que en GSE91061.
############################################################

meta_eval <- meta_eval %>%
  mutate(
    
    response_code = case_when(
      
      str_detect(
        response_text,
        regex(
          "complete response|\\bCR\\b",
          ignore_case = TRUE
        )
      ) ~ "CR",
      
      str_detect(
        response_text,
        regex(
          "partial response|\\bPR\\b",
          ignore_case = TRUE
        )
      ) ~ "PR",
      
      str_detect(
        response_text,
        regex(
          "stable disease|\\bSD\\b",
          ignore_case = TRUE
        )
      ) ~ "SD",
      
      str_detect(
        response_text,
        regex(
          "progressive disease|\\bPD\\b",
          ignore_case = TRUE
        )
      ) ~ "PD",
      
      TRUE ~ NA_character_
    ),
    
    
    response_group = case_when(
      
      response_code %in% c(
        "CR",
        "PR"
      ) ~ "Responder",
      
      response_code == "PD" ~ "NonResponder",
      
      response_code == "SD" ~ NA_character_,
      
      TRUE ~ NA_character_
    )
  )


# ----------------------------------------------------------
# 17.5. Comprobar clasificación
# ----------------------------------------------------------

cat(
  "\nCorrespondencia respuesta original - grupo analítico GSE78220:\n"
)

print(
  table(
    meta_eval$response_code,
    meta_eval$response_group,
    useNA = "ifany"
  )
)


############################################################
# 17.6. COMPROBAR QUE TODAS LAS MUESTRAS SON PRETRATAMIENTO
############################################################

if ("biopsy_time" %in% colnames(meta_eval)) {
  
  cat("\nMomentos de biopsia en GSE78220:\n")
  
  print(
    table(
      meta_eval$biopsy_time,
      useNA = "ifany"
    )
  )
  
}


############################################################
# 17.7. Seleccionar cohorte de priorización
############################################################

meta_eval_final <- meta_eval %>%
  filter(
    !is.na(response_group)
  )


meta_eval_final$response_group <- factor(
  meta_eval_final$response_group,
  levels = c(
    "NonResponder",
    "Responder"
  )
)


cat("\nDistribución de muestras GSE78220:\n")

print(
  table(
    meta_eval_final$response_group
  )
)


cat("\nNúmero de pacientes únicos GSE78220:\n")

print(
  n_distinct(
    meta_eval_final$patient_id
  )
)


############################################################
# 18. LECTURA DE LA MATRIZ FPKM DE GSE78220
############################################################

# ----------------------------------------------------------
# 18.1. Localizar archivo Excel automáticamente
# ----------------------------------------------------------

xlsx_files <- list.files(
  "GSE78220",
  pattern = "\\.xlsx$",
  full.names = TRUE,
  recursive = TRUE
)


cat("\nArchivo(s) Excel encontrados:\n")
print(xlsx_files)


stopifnot(length(xlsx_files) >= 1)


fpkm_file <- xlsx_files[1]


# ----------------------------------------------------------
# 18.2. Revisar hojas del archivo
# ----------------------------------------------------------

cat("\nHojas disponibles en archivo FPKM:\n")

print(
  excel_sheets(
    fpkm_file
  )
)


# ----------------------------------------------------------
# 18.3. Leer primera hoja
# ----------------------------------------------------------

fpkm_raw <- read_excel(
  fpkm_file,
  sheet = 1
)


cat("\nDimensiones originales del archivo FPKM:\n")
print(dim(fpkm_raw))

cat("\nPrimeras columnas:\n")
print(colnames(fpkm_raw)[1:min(10, ncol(fpkm_raw))])

head(fpkm_raw)


############################################################
# 18.4. IDENTIFICAR COLUMNA DE GENES
#
# El código busca nombres habituales:
#
# gene
# gene_symbol
# symbol
# gene_name
#
# Si no encuentra automáticamente una columna adecuada,
# mostrará las primeras columnas para revisión manual.
############################################################

gene_col_candidates <- grep(
  "gene.*symbol|symbol|gene.*name|^gene$",
  colnames(fpkm_raw),
  value = TRUE,
  ignore.case = TRUE
)


cat("\nColumnas candidatas para identificador génico:\n")
print(gene_col_candidates)


if (length(gene_col_candidates) == 0) {
  
  stop(
    "No se identificó automáticamente la columna de genes. ",
    "Revisar colnames(fpkm_raw) y definir gene_col_eval manualmente."
  )
  
}


gene_col_eval <- gene_col_candidates[1]


cat("\nColumna utilizada como identificador génico:\n")
print(gene_col_eval)


############################################################
# 18.5. IDENTIFICAR Y ARMONIZAR COLUMNAS DE MUESTRAS
#
# En el archivo FPKM de GSE78220 los nombres aparecen como:
#
# Pt1.baseline
# Pt2.baseline
# Pt27A.baseline
# Pt27B.baseline
# Pt16.onTx
#
# Mientras que en los metadatos GEO aparecen como:
#
# Pt1
# Pt2
# Pt27A
# Pt27B
# Pt16
#
# Por ello se eliminará el sufijo ".baseline" para relacionar
# correctamente la matriz de expresión con los metadatos.
#
# Las muestras ".onTx" se excluirán del análisis predictivo,
# ya que corresponden a biopsias obtenidas durante tratamiento.
############################################################

# ----------------------------------------------------------
# 18.5.1. Identificar únicamente columnas baseline
# ----------------------------------------------------------

baseline_cols_eval <- grep(
  "\\.baseline$",
  colnames(fpkm_raw),
  value = TRUE
)

cat("\nNúmero de columnas baseline encontradas:\n")
print(length(baseline_cols_eval))

cat("\nColumnas baseline:\n")
print(baseline_cols_eval)


# ----------------------------------------------------------
# 18.5.2. Identificar muestras durante tratamiento
# ----------------------------------------------------------

ontx_cols_eval <- grep(
  "\\.onTx$",
  colnames(fpkm_raw),
  value = TRUE,
  ignore.case = TRUE
)

cat("\nMuestras on-treatment encontradas:\n")
print(ontx_cols_eval)


# ----------------------------------------------------------
# 18.5.3. Crear correspondencia entre nombres del Excel
#         y nombres de los metadatos
# ----------------------------------------------------------

sample_map_eval <- data.frame(
  excel_name = baseline_cols_eval,
  
  sample_id = str_remove(
    baseline_cols_eval,
    "\\.baseline$"
  ),
  
  stringsAsFactors = FALSE
)


cat("\nCorrespondencia entre columnas del Excel y sample_id:\n")
print(sample_map_eval)


# ----------------------------------------------------------
# 18.5.4. Comprobar qué muestras baseline existen
#         también en los metadatos clínicos
# ----------------------------------------------------------

sample_map_eval <- sample_map_eval %>%
  mutate(
    present_in_metadata =
      sample_id %in% meta_eval_final$sample_id
  )


cat("\nCorrespondencia de muestras baseline con metadatos:\n")

print(
  table(
    sample_map_eval$present_in_metadata
  )
)


# Mostrar posibles columnas sin correspondencia
unmatched_excel <- sample_map_eval %>%
  filter(!present_in_metadata)

cat("\nColumnas baseline sin correspondencia en metadatos:\n")
print(unmatched_excel)


# ----------------------------------------------------------
# 18.5.5. Comprobar si existen muestras de los metadatos
#         que no estén presentes como baseline en el Excel
# ----------------------------------------------------------

unmatched_metadata <- setdiff(
  meta_eval_final$sample_id,
  sample_map_eval$sample_id
)

cat("\nMuestras de metadatos sin expresión baseline:\n")
print(unmatched_metadata)


# ----------------------------------------------------------
# 18.5.6. Conservar únicamente coincidencias válidas
# ----------------------------------------------------------

sample_map_eval <- sample_map_eval %>%
  filter(present_in_metadata)


# Debe existir al menos una muestra válida
stopifnot(nrow(sample_map_eval) > 0)


cat(
  "\nNúmero final de muestras baseline disponibles para priorización:",
  nrow(sample_map_eval),
  "\n"
)

############################################################
# 18.6. CONSTRUIR MATRIZ FPKM CON MUESTRAS BASELINE
############################################################

fpkm_df <- fpkm_raw %>%
  select(
    all_of(gene_col_eval),
    all_of(sample_map_eval$excel_name)
  ) %>%
  as.data.frame()


# Renombrar primera columna como SYMBOL
colnames(fpkm_df)[1] <- "SYMBOL"


# ----------------------------------------------------------
# Cambiar nombres de columnas:
#
# Pt1.baseline -> Pt1
# Pt2.baseline -> Pt2
# Pt27A.baseline -> Pt27A
# ----------------------------------------------------------

colnames(fpkm_df)[-1] <- sample_map_eval$sample_id


# Comprobar los nombres finales
cat("\nNombres finales de las columnas de expresión:\n")
print(colnames(fpkm_df)[1:min(15, ncol(fpkm_df))])


# Eliminar genes sin símbolo válido
fpkm_df <- fpkm_df %>%
  filter(
    !is.na(SYMBOL),
    SYMBOL != ""
  )


# Combinar genes duplicados mediante expresión media
fpkm_df <- fpkm_df %>%
  group_by(SYMBOL) %>%
  summarise(
    across(
      everything(),
      ~ mean(as.numeric(.x), na.rm = TRUE)
    ),
    .groups = "drop"
  )


# Crear matriz numérica
fpkm_mat <- fpkm_df %>%
  column_to_rownames("SYMBOL") %>%
  as.matrix()


storage.mode(fpkm_mat) <- "numeric"


# Comprobaciones
stopifnot(!any(fpkm_mat < 0, na.rm = TRUE))

cat("\nDimensiones de la matriz FPKM final:\n")
print(dim(fpkm_mat))


############################################################
# 19. PREPROCESAMIENTO DEL DATASET DE PRIORIZACIÓN
#
# Los valores FPKM se transforman mediante:
#
# log2(FPKM + 1)
#
# Esto permite reducir asimetría y comparar niveles de
# expresión dentro de GSE78220.
#
# NO se utilizarán estos valores para DESeq2.
############################################################

############################################################
# 19.1. ALINEAR METADATOS Y MATRIZ DE EXPRESIÓN
############################################################

# Conservar únicamente muestras presentes en la matriz
meta_eval_expr <- meta_eval_final %>%
  filter(
    sample_id %in% colnames(fpkm_mat)
  )


# Reordenar metadata exactamente en el orden de la matriz
meta_eval_expr <- meta_eval_expr[
  match(
    colnames(fpkm_mat),
    meta_eval_expr$sample_id
  ),
  ,
  drop = FALSE
]


# Comprobación crítica
stopifnot(
  all(
    colnames(fpkm_mat) ==
      meta_eval_expr$sample_id
  )
)


cat(
  "\nCORRECTO: matriz FPKM y metadatos de GSE78220 están alineados.\n"
)


cat("\nNúmero de muestras finales de priorización:\n")
print(ncol(fpkm_mat))


cat("\nDistribución por respuesta:\n")
print(
  table(
    meta_eval_expr$response_group
  )
)

############################################################
# 19.2. TRANSFORMACIÓN LOG2(FPKM + 1)
############################################################

log_fpkm <- log2(
  fpkm_mat + 1
)

# Comprobar que la transformación no generó valores no finitos
stopifnot(all(is.finite(log_fpkm)))

# Revisar distribución
summary(
  as.numeric(log_fpkm)
)


############################################################
# 19.3. CONTROL DE CALIDAD BÁSICO DE GSE78220
#
# Se evalúan características generales de la matriz de
# expresión del dataset independiente antes del PCA y de
# la evaluación de reproducibilidad de los biomarcadores candidatos.
#
# Se revisan:
# - número de genes
# - número de muestras
# - ausencia de valores NA/no finitos
# - proporción de valores FPKM iguales a cero por muestra
# - correspondencia con los grupos clínicos
############################################################

# ----------------------------------------------------------
# 19.3.1. Dimensiones de la matriz
# ----------------------------------------------------------

cat("\nNúmero de genes GSE78220:\n")
print(nrow(log_fpkm))

cat("\nNúmero de muestras GSE78220:\n")
print(ncol(log_fpkm))


# ----------------------------------------------------------
# 19.3.2. Comprobar integridad de los datos
# ----------------------------------------------------------

stopifnot(!anyNA(log_fpkm))
stopifnot(all(is.finite(log_fpkm)))
stopifnot(all(fpkm_mat >= 0))


cat(
  "\nCORRECTO: la matriz no contiene NA,",
  "valores infinitos ni valores negativos.\n"
)


# ----------------------------------------------------------
# 19.3.3. Comprobar nuevamente alineación
# ----------------------------------------------------------

stopifnot(
  all(
    colnames(log_fpkm) ==
      meta_eval_expr$sample_id
  )
)

cat(
  "\nCORRECTO: expresión y metadatos permanecen alineados.\n"
)


# ----------------------------------------------------------
# 19.3.4. Proporción de ceros por muestra
#
# Se calcula utilizando los FPKM originales,
# antes de la transformación log2(FPKM + 1).
# ----------------------------------------------------------

zero_fraction_eval <- colMeans(
  fpkm_mat[
    ,
    colnames(log_fpkm),
    drop = FALSE
  ] == 0
)


# ----------------------------------------------------------
# 19.3.5. Crear tabla de QC por muestra
# ----------------------------------------------------------

qc_eval <- data.frame(
  sample_id = colnames(log_fpkm),
  zero_fraction = zero_fraction_eval,
  response_group = meta_eval_expr$response_group
)


cat("\nResumen de la proporción de ceros por muestra:\n")

print(
  summary(
    qc_eval$zero_fraction
  )
)


# Mostrar muestras con mayor proporción de ceros
cat("\nMuestras con mayor proporción de ceros:\n")

print(
  qc_eval %>%
    arrange(desc(zero_fraction)) %>%
    head(10)
)


# ----------------------------------------------------------
# 19.3.6. Comprobar distribución de grupos clínicos
# ----------------------------------------------------------

cat("\nDistribución clínica de las muestras utilizadas:\n")

print(
  table(
    qc_eval$response_group,
    useNA = "ifany"
  )
)


############################################################
# 19.4. PCA DEL DATASET DE PRIORIZACIÓN GSE78220
#
# Objetivos:
#
# - evaluar la estructura global de las muestras
# - identificar posibles muestras atípicas
# - observar si existe agrupamiento relacionado con respuesta
#
# Se seleccionan los genes con mayor varianza después de
# transformar los valores mediante log2(FPKM + 1).
############################################################

# ----------------------------------------------------------
# 19.4.1. Calcular varianza de cada gen
# ----------------------------------------------------------

gene_variance_eval <- apply(
  log_fpkm,
  1,
  var,
  na.rm = TRUE
)


# ----------------------------------------------------------
# 19.4.2. Eliminar genes sin variabilidad
#
# Los genes con varianza cero no aportan información al PCA.
# ----------------------------------------------------------

gene_variance_eval <- gene_variance_eval[
  is.finite(gene_variance_eval) &
    gene_variance_eval > 0
]


cat(
  "\nGenes con varianza mayor que cero:",
  length(gene_variance_eval),
  "\n"
)


# ----------------------------------------------------------
# 19.4.3. Seleccionar los 500 genes de mayor varianza
#
# Si existen menos de 500, se utilizan todos los disponibles.
# ----------------------------------------------------------

n_top_var <- min(
  500,
  length(gene_variance_eval)
)


top_var_eval <- names(
  sort(
    gene_variance_eval,
    decreasing = TRUE
  )
)[
  seq_len(n_top_var)
]


cat(
  "\nNúmero de genes utilizados para el PCA:",
  length(top_var_eval),
  "\n"
)


# ----------------------------------------------------------
# 19.4.4. Realizar PCA
#
# Las muestras deben estar en filas y los genes en columnas,
# por ello se transpone la matriz.
#
# center = TRUE:
# centra cada gen respecto a su media.
#
# scale. = FALSE:
# no se estandariza cada gen a varianza 1 porque ya hemos
# seleccionado los genes de mayor variabilidad.
# ----------------------------------------------------------

pca_eval <- prcomp(
  t(
    log_fpkm[
      top_var_eval,
      ,
      drop = FALSE
    ]
  ),
  center = TRUE,
  scale. = FALSE
)


# ----------------------------------------------------------
# 19.4.5. Calcular porcentaje de varianza explicado
# ----------------------------------------------------------

variance_eval <- summary(
  pca_eval
)$importance[2, 1:2] * 100


cat("\nVarianza explicada por PC1 y PC2:\n")
print(variance_eval)


# ----------------------------------------------------------
# 19.4.6. Construir tabla para visualizar PCA
#
# IMPORTANTE:
# Se utiliza sample_id, no expression_id.
# ----------------------------------------------------------

pca_eval_df <- data.frame(
  sample_id = rownames(pca_eval$x),
  PC1 = pca_eval$x[, 1],
  PC2 = pca_eval$x[, 2]
) %>%
  left_join(
    meta_eval_expr %>%
      select(
        sample_id,
        patient_id,
        response_group
      ),
    by = "sample_id"
  )


# Comprobar que todas las muestras recibieron metadata clínica
stopifnot(
  !anyNA(
    pca_eval_df$response_group
  )
)


# ----------------------------------------------------------
# 19.4.7. Visualizar PCA según respuesta clínica
# ----------------------------------------------------------

pca_eval_plot <- ggplot(
  pca_eval_df,
  aes(
    x = PC1,
    y = PC2,
    color = response_group
  )
) +
  geom_point(
    size = 3,
    alpha = 0.8
  ) +
  xlab(
    paste0(
      "PC1: ",
      round(variance_eval[1], 1),
      "% de varianza"
    )
  ) +
  ylab(
    paste0(
      "PC2: ",
      round(variance_eval[2], 1),
      "% de varianza"
    )
  ) +
  labs(
    title = "PCA de la cohorte independiente GSE78220",
    subtitle = "Muestras baseline tratadas con anti-PD-1",
    color = "Respuesta"
  ) +
  theme_minimal()


print(pca_eval_plot)


# ----------------------------------------------------------
# 19.4.8. PCA con identificadores de muestra
#
# Permite reconocer visualmente posibles muestras alejadas.
# ----------------------------------------------------------

pca_eval_labels <- ggplot(
  pca_eval_df,
  aes(
    x = PC1,
    y = PC2,
    color = response_group,
    label = sample_id
  )
) +
  geom_point(
    size = 3
  ) +
  geom_text(
    vjust = -0.8,
    size = 3,
    check_overlap = TRUE
  ) +
  xlab(
    paste0(
      "PC1: ",
      round(variance_eval[1], 1),
      "% de varianza"
    )
  ) +
  ylab(
    paste0(
      "PC2: ",
      round(variance_eval[2], 1),
      "% de varianza"
    )
  ) +
  labs(
    title = "PCA de GSE78220 con identificación de muestras",
    color = "Respuesta"
  ) +
  theme_minimal()


print(pca_eval_labels)

############################################################
# 19.5. AGREGACIÓN A NIVEL DE PACIENTE
#
# Algunas muestras, como Pt27A y Pt27B, corresponden a
# biopsias diferentes del mismo paciente.
#
# Para evitar pseudorreplicación en la evaluación estadística,
# cada paciente debe aportar una sola observación.
#
# Las biopsias múltiples de un mismo paciente se resumirán
# mediante la media de su expresión log2(FPKM + 1).
############################################################


# ----------------------------------------------------------
# 19.5.1. Crear identificador biológico de paciente
#
# Pt27A -> Pt27
# Pt27B -> Pt27
#
# Las muestras sin sufijo permanecen iguales:
# Pt1 -> Pt1
# Pt2 -> Pt2
# ----------------------------------------------------------

meta_eval_expr <- meta_eval_expr %>%
  mutate(
    biological_patient_id = str_replace(
      sample_id,
      "^((?i:Pt)\\d+)[A-Z]$",
      "\\1"
    )
  )


# Revisar posibles pacientes con varias biopsias
patient_sample_check <- meta_eval_expr %>%
  count(
    biological_patient_id,
    name = "n_samples"
  ) %>%
  filter(
    n_samples > 1
  )

cat("\nPacientes con más de una biopsia baseline:\n")
print(patient_sample_check)


# ----------------------------------------------------------
# 19.5.2. Comprobar que biopsias del mismo paciente tienen
#         la misma clasificación de respuesta
# ----------------------------------------------------------

patient_response_check_eval <- meta_eval_expr %>%
  distinct(
    biological_patient_id,
    response_group
  ) %>%
  count(
    biological_patient_id,
    name = "n_response_groups"
  ) %>%
  filter(
    n_response_groups > 1
  )

cat(
  "\nPacientes con respuestas clínicas inconsistentes entre biopsias:\n"
)

print(patient_response_check_eval)


# Debe ser cero.
stopifnot(
  nrow(patient_response_check_eval) == 0
)


# ----------------------------------------------------------
# 19.5.3. Agregar expresión a nivel de paciente
#
# Primero convertimos la matriz a formato largo.
# Después calculamos la media de expresión de las biopsias
# correspondientes al mismo paciente.
# ----------------------------------------------------------

log_fpkm_long <- log_fpkm %>%
  as.data.frame() %>%
  rownames_to_column("SYMBOL") %>%
  pivot_longer(
    cols = -SYMBOL,
    names_to = "sample_id",
    values_to = "expression"
  ) %>%
  left_join(
    meta_eval_expr %>%
      select(
        sample_id,
        biological_patient_id
      ),
    by = "sample_id"
  )


# Media por gen y paciente
log_fpkm_patient_df <- log_fpkm_long %>%
  group_by(
    SYMBOL,
    biological_patient_id
  ) %>%
  summarise(
    expression = mean(
      expression,
      na.rm = TRUE
    ),
    .groups = "drop"
  ) %>%
  pivot_wider(
    names_from = biological_patient_id,
    values_from = expression
  )


# Convertir a matriz
log_fpkm_patient <- log_fpkm_patient_df %>%
  column_to_rownames("SYMBOL") %>%
  as.matrix()


storage.mode(log_fpkm_patient) <- "numeric"


# ----------------------------------------------------------
# 19.5.4. Crear metadatos a nivel de paciente
# ----------------------------------------------------------

meta_eval_patient <- meta_eval_expr %>%
  distinct(
    biological_patient_id,
    response_group
  )


# Reordenar según la matriz
meta_eval_patient <- meta_eval_patient[
  match(
    colnames(log_fpkm_patient),
    meta_eval_patient$biological_patient_id
  ),
  ,
  drop = FALSE
]


# Comprobación crítica
stopifnot(
  all(
    colnames(log_fpkm_patient) ==
      meta_eval_patient$biological_patient_id
  )
)


cat(
  "\nNúmero de pacientes independientes para priorización:",
  ncol(log_fpkm_patient),
  "\n"
)

cat("\nDistribución de respuesta a nivel de paciente:\n")

print(
  table(
    meta_eval_patient$response_group
  )
)

############################################################
