############################################################
# 25.5. LEER MATRIZ FPKM
############################################################

fpkm_ext_raw <- read.delim(
  "GSE145996/GSE145996_Melanoma_Immune_FPKM.txt.gz",
  check.names = FALSE,
  stringsAsFactors = FALSE
)


cat("\nDimensiones del archivo FPKM:\n")
print(dim(fpkm_ext_raw))


cat("\nPrimeras columnas:\n")
print(colnames(fpkm_ext_raw))


cat("\nPrimeras filas:\n")
print(head(fpkm_ext_raw))

############################################################
# 25.6. CONSTRUIR TABLA CLÍNICA DE GSE145996
#
# Información obtenida de las tablas suplementarias
# originales de Amato et al.:
#
# Supplemental Table 1:
# - Patient Number
# - Drug
# - Best Response
#
# Supplemental Table 2:
# - Patient Number
# - Tumor ID number
# - RNASEQ
#
# Se cruzaron únicamente los especímenes con RNASEQ = 1.
############################################################

clinical_ext <- data.frame(
  
  tumor_id = c(
    "MB1692",
    "MB2781",
    "MB2786",
    "MB2674",
    "MB2750",
    "MB2855",
    "MB1882",
    "MB3025",
    "MB3178",
    "MB3432",
    "MB3316",
    "MB3838",
    "MB4103",
    "MB4117"
  ),
  
  patient_id = c(
    "P0112",
    "P0187",
    "P0195",
    "P0199",
    "P0200",
    "P0243",
    "P0268",
    "P0315",
    "P0349",
    "P0370",
    "P0375",
    "P0418",
    "P0487",
    "P0488"
  ),
  
  drug = c(
    "Pembrolizumab",
    "Pembrolizumab",
    "Pembrolizumab",
    "Pembrolizumab",
    "Pembrolizumab",
    "Pembrolizumab",
    "Pembrolizumab",
    "Pembrolizumab",
    "Pembrolizumab",
    "Pembrolizumab",
    "Nivolumab",
    "Nivolumab",
    "Pembrolizumab",
    "Pembrolizumab"
  ),
  
  best_response = c(
    "CR",
    "PR",
    "PD",
    "CR",
    "PR",
    "PD",
    "PR",
    "PR",
    "PR",
    "PD",
    "PD",
    "SD",
    "PR",
    "PD"
  ),
  
  stringsAsFactors = FALSE
)

############################################################
# 25.7. DEFINICIÓN DE RESPUESTA CLÍNICA
#
# Se construyen dos variables de respuesta:
#
# response_group_primary:
#   CR/PR -> Responder
#   PD    -> NonResponder
#   SD    -> excluido
#
# Esta definición reproduce exactamente el contraste
# utilizado durante descubrimiento y priorización.
#
# response_group_objective:
#   CR/PR -> Responder
#   SD/PD -> NonResponder
#
# Clasificación basada en presencia o ausencia de respuesta
# objetiva:
#
# CR/PR -> Responder (respuesta objetiva)
# SD/PD -> NonResponder (sin respuesta objetiva)
#
# Esta segunda clasificación se utilizará únicamente
# como análisis de sensibilidad.
############################################################

clinical_ext <- clinical_ext %>%
  mutate(
    
    response_group_primary = case_when(
      
      best_response %in% c("CR", "PR") ~
        "Responder",
      
      best_response == "PD" ~
        "NonResponder",
      
      TRUE ~
        NA_character_
    ),
    
    response_group_objective = case_when(
      
      best_response %in% c("CR", "PR") ~
        "Responder",
      
      best_response %in% c("SD", "PD") ~
        "NonResponder",
      
      TRUE ~
        NA_character_
    )
  )


clinical_ext$response_group_primary <- factor(
  clinical_ext$response_group_primary,
  levels = c(
    "NonResponder",
    "Responder"
  )
)


clinical_ext$response_group_objective <- factor(
  clinical_ext$response_group_objective,
  levels = c(
    "NonResponder",
    "Responder"
  )
)

cat("\nRespuesta primaria CR/PR vs PD:\n")

print(
  table(
    clinical_ext$response_group_primary,
    useNA = "ifany"
  )
)

cat("\nRespuesta objetiva CR/PR vs SD/PD:\n")

print(
  table(
    clinical_ext$response_group_objective,
    useNA = "ifany"
  )
)


############################################################
# 25.8. COMPROBACIONES DE LA COHORTE CLÍNICA
############################################################

cat("\nDistribución de respuesta original:\n")

print(
  table(
    clinical_ext$best_response
  )
)


cat("\nDistribución análisis principal CR/PR vs PD:\n")

print(
  table(
    clinical_ext$response_group_primary,
    useNA = "ifany"
  )
)


cat("\nDistribución análisis de sensibilidad CR/PR vs SD/PD:\n")

print(
  table(
    clinical_ext$response_group_objective,
    useNA = "ifany"
  )
)


cat("\nNúmero de pacientes:\n")

print(
  length(
    unique(
      clinical_ext$patient_id
    )
  )
)


cat("\nNúmero de muestras tumorales:\n")

print(
  length(
    unique(
      clinical_ext$tumor_id
    )
  )
)


############################################################
# 25.9. RELACIONAR METADATOS CLÍNICOS CON LA MATRIZ FPKM
#
# Las columnas de expresión tienen nombres como:
#
# Sample_01_MB_1692
# Sample_02_MB_2674
# ...
#
# Mientras que clinical_ext utiliza:
#
# MB1692
# MB2674
#
# Se extraerá el identificador MB de cada columna.
############################################################

sample_map_ext <- data.frame(
  
  expression_id = colnames(fpkm_ext_raw)[-c(1, 2)],
  
  stringsAsFactors = FALSE
  
) %>%
  mutate(
    
    # Extraer identificador MB
    tumor_id = str_extract(
      expression_id,
      "MB_?\\d+"
    ),
    
    # Homogeneizar:
    #
    # MB_1692 -> MB1692
    # MB1692  -> MB1692
    
    tumor_id = str_remove(
      tumor_id,
      "_"
    )
  )


cat("\nCorrespondencia expresión - tumor ID:\n")

print(
  sample_map_ext
)


############################################################
# 25.10. UNIR INFORMACIÓN DE EXPRESIÓN Y RESPUESTA CLÍNICA
############################################################

meta_ext_final <- sample_map_ext %>%
  left_join(
    clinical_ext,
    by = "tumor_id"
  )


cat("\nTabla clínica final de las muestras RNA-seq:\n")

print(
  meta_ext_final
)


############################################################
# 25.11. COMPROBACIONES DE CORRESPONDENCIA
############################################################

# Deben existir exactamente 14 muestras RNA-seq
stopifnot(
  nrow(meta_ext_final) == 14
)

# Todas deben tener respuesta clínica original
stopifnot(
  !anyNA(meta_ext_final$best_response)
)

# La definición de sensibilidad debe existir para las 14
stopifnot(
  !anyNA(meta_ext_final$response_group_objective)
)

# La definición principal debe contener exactamente un NA,
# correspondiente al único paciente con SD
stopifnot(
  sum(is.na(meta_ext_final$response_group_primary)) == 1
)

# Cada tumor debe aparecer una sola vez
stopifnot(
  !anyDuplicated(meta_ext_final$tumor_id)
)

# Cada paciente debe aparecer una sola vez
stopifnot(
  !anyDuplicated(meta_ext_final$patient_id)
)

# Las 14 columnas de expresión deben haber sido mapeadas
stopifnot(
  setequal(
    sample_map_ext$expression_id,
    colnames(fpkm_ext_raw)[-c(1, 2)]
  )
)

cat(
  "\nCORRECTO: las 14 muestras RNA-seq corresponden ",
  "a 14 pacientes independientes y disponen de ",
  "información clínica válida.\n"
)


cat("\nDistribución final - análisis principal:\n")

print(
  table(
    meta_ext_final$response_group_primary,
    useNA = "ifany"
  )
)


cat("\nDistribución final - análisis de sensibilidad:\n")

print(
  table(
    meta_ext_final$response_group_objective,
    useNA = "ifany"
  )
)


############################################################
# 26. CONSTRUCCIÓN DE LA MATRIZ DE EXPRESIÓN GSE145996
#
# El archivo contiene:
#
# columna 1 = Gene Name
# columna 2 = Locus
# columnas 3-16 = 14 muestras RNA-seq
#
# Se utilizarán únicamente símbolos génicos inequívocos.
#
# Las filas que contienen varios genes separados por coma
# no se asignarán artificialmente a genes individuales.
############################################################


# ----------------------------------------------------------
# 26.1. Seleccionar genes y columnas de expresión
# ----------------------------------------------------------

fpkm_ext_df <- fpkm_ext_raw %>%
  select(
    `Gene Name`,
    all_of(meta_ext_final$expression_id)
  ) %>%
  as.data.frame()


# Renombrar la columna génica
colnames(fpkm_ext_df)[1] <- "SYMBOL"


# ----------------------------------------------------------
# 26.2. Limpiar símbolos génicos
# ----------------------------------------------------------

fpkm_ext_df$SYMBOL <- str_trim(
  as.character(fpkm_ext_df$SYMBOL)
)


# Eliminar genes sin símbolo
fpkm_ext_df <- fpkm_ext_df %>%
  filter(
    !is.na(SYMBOL),
    SYMBOL != ""
  )


# ----------------------------------------------------------
# 26.3. Excluir identificadores ambiguos
#
# Ejemplo:
#
# MIR4647,NFKBIE,SLC35B2
#
# representa una fila asociada a varios genes y no debe
# utilizarse para validar un biomarcador individual.
# ----------------------------------------------------------

ambiguous_gene_rows <- str_detect(
  fpkm_ext_df$SYMBOL,
  ","
)


cat(
  "\nFilas con múltiples símbolos génicos:",
  sum(ambiguous_gene_rows),
  "\n"
)


fpkm_ext_df <- fpkm_ext_df %>%
  filter(
    !str_detect(SYMBOL, ",")
  )


# ----------------------------------------------------------
# 26.4. Convertir expresión a formato numérico
# ----------------------------------------------------------

sample_columns_ext <- meta_ext_final$expression_id


fpkm_ext_df <- fpkm_ext_df %>%
  mutate(
    across(
      all_of(sample_columns_ext),
      as.numeric
    )
  )


# ----------------------------------------------------------
# 26.5. Resolver símbolos duplicados
#
# Si un mismo símbolo aparece en varias filas inequívocas,
# se calcula la expresión media.
# ----------------------------------------------------------

fpkm_ext_df <- fpkm_ext_df %>%
  group_by(SYMBOL) %>%
  summarise(
    across(
      all_of(sample_columns_ext),
      ~ mean(.x, na.rm = TRUE)
    ),
    .groups = "drop"
  )


# ----------------------------------------------------------
# 26.6. Crear matriz genes × muestras
# ----------------------------------------------------------

fpkm_ext <- fpkm_ext_df %>%
  column_to_rownames("SYMBOL") %>%
  as.matrix()


storage.mode(fpkm_ext) <- "numeric"


# ----------------------------------------------------------
# 26.7. Comprobaciones
# ----------------------------------------------------------

stopifnot(
  ncol(fpkm_ext) == 14
)

stopifnot(
  !anyNA(fpkm_ext)
)

stopifnot(
  all(fpkm_ext >= 0)
)

stopifnot(
  all(
    colnames(fpkm_ext) ==
      meta_ext_final$expression_id
  )
)


cat(
  "\nDimensiones finales de GSE145996:\n"
)

print(
  dim(fpkm_ext)
)


cat(
  "\nCORRECTO: matriz FPKM externa construida y alineada.\n"
)


############################################################
# 27. PREPROCESAMIENTO DE GSE145996
#
# Se transforma:
#
# FPKM -> log2(FPKM + 1)
#
# Esta transformación se aplica antes de utilizar la firma.
############################################################

# ----------------------------------------------------------
# 27.1. Transformación
# ----------------------------------------------------------

log_fpkm_ext <- log2(
  fpkm_ext + 1
)


# Comprobar integridad
stopifnot(
  all(
    is.finite(log_fpkm_ext)
  )
)


cat(
  "\nResumen de expresión log2(FPKM + 1):\n"
)

print(
  summary(
    as.numeric(log_fpkm_ext)
  )
)


# ----------------------------------------------------------
# 27.2. Proporción de ceros
# ----------------------------------------------------------

zero_fraction_ext <- colMeans(
  fpkm_ext == 0
)


qc_ext <- data.frame(
  
  expression_id =
    colnames(fpkm_ext),
  
  zero_fraction =
    zero_fraction_ext
  
) %>%
  
  left_join(
    meta_ext_final %>%
      select(
        expression_id,
        patient_id,
        response_group_primary,
        response_group_objective
      ),
    by = "expression_id"
  )


cat(
  "\nResumen de proporción de ceros:\n"
)

print(
  summary(
    qc_ext$zero_fraction
  )
)


print(
  qc_ext %>%
    arrange(
      desc(zero_fraction)
    )
)


############################################################
# 28. COMPROBAR FIRMA CONGELADA EN GSE145996
#
# GSE145996 NO participa en:
#
# - descubrimiento de genes
# - selección de biomarcadores
# - elección del número de genes
# - definición de dirección/pesos
############################################################


stopifnot(
  exists("final_signature")
)


cat(
  "\nGenes de la firma previamente congelada:\n"
)

print(
  final_signature$SYMBOL
)


# ----------------------------------------------------------
# 28.1. Comprobar presencia de genes
# ----------------------------------------------------------

signature_presence_ext <- data.frame(
  
  SYMBOL =
    final_signature$SYMBOL,
  
  present_in_GSE145996 =
    final_signature$SYMBOL %in%
    rownames(log_fpkm_ext)
  
)


print(
  signature_presence_ext
)


missing_signature_genes <- signature_presence_ext %>%
  filter(
    !present_in_GSE145996
  )


cat(
  "\nGenes de la firma ausentes en GSE145996:\n"
)

print(
  missing_signature_genes
)


if (
  nrow(missing_signature_genes) > 0
) {
  
  stop(
    "La firma congelada no está completamente representada ",
    "en GSE145996. Debe revisarse antes de continuar con ",
    "la evaluación externa."
  )
  
}

cat("\nNúmero de genes de la firma:", nrow(final_signature), "\n")

cat(
  "Genes presentes en GSE145996:",
  sum(signature_presence_ext$present_in_GSE145996),
  "\n"
)

cat(
  "Genes ausentes:",
  nrow(missing_signature_genes),
  "\n"
)


############################################################
# 29. APLICACIÓN DE LA FIRMA A GSE145996
#
# No se reentrena ningún modelo.
# No se seleccionan genes.
# No se recalculan pesos.
#
# Se aplican directamente los parámetros congelados.
############################################################

# ----------------------------------------------------------
# 29.1. Extraer expresión de genes de la firma
# ----------------------------------------------------------

external_signature_matrix <- log_fpkm_ext[
  final_signature$SYMBOL,
  ,
  drop = FALSE
]


# Comprobar orden
stopifnot(
  all(
    rownames(external_signature_matrix) ==
      final_signature$SYMBOL
  )
)

# ----------------------------------------------------------
# 29.2. Estandarizar utilizando parámetros de GSE78220
#
# (x - media_entrenamiento) / SD_entrenamiento
# ----------------------------------------------------------

external_signature_z <- sweep(
  external_signature_matrix,
  1,
  signature_center,
  "-"
)


external_signature_z <- sweep(
  external_signature_z,
  1,
  signature_scale,
  "/"
)


stopifnot(
  all(
    is.finite(
      external_signature_z
    )
  )
)


# ----------------------------------------------------------
# 29.3. Aplicar pesos congelados
# ----------------------------------------------------------

weighted_external <- external_signature_z *
  signature_weights[
    rownames(external_signature_z)
  ]


# ----------------------------------------------------------
# 29.4. Calcular score
# ----------------------------------------------------------

external_score <- colMeans(
  weighted_external,
  na.rm = TRUE
)


# ----------------------------------------------------------
# 29.5. Asociar respuesta clínica
# ----------------------------------------------------------

external_score_df <- data.frame(
  
  expression_id =
    names(external_score),
  
  signature_score =
    as.numeric(external_score)
  
) %>%
  
  left_join(
    meta_ext_final %>%
      select(
        expression_id,
        tumor_id,
        patient_id,
        drug,
        best_response,
        response_group_primary,
        response_group_objective
      ),
    by = "expression_id"
  )


# Comprobaciones

stopifnot(
  nrow(external_score_df) == 14
)

stopifnot(
  !anyNA(external_score_df$best_response)
)

stopifnot(
  !anyNA(external_score_df$response_group_objective)
)

stopifnot(
  sum(is.na(external_score_df$response_group_primary)) == 1
)


cat(
  "\nScore externo calculado para 14 pacientes.\n"
)

print(
  external_score_df
)

############################################################
# 29.6. DEFINIR COHORTE DE EVALUACIÓN EXTERNA PRINCIPAL
#
# El análisis principal mantiene exactamente la definición
# utilizada en GSE91061 y GSE78220:
#
# CR / PR -> Responder
# PD      -> NonResponder
# SD      -> excluido
############################################################

external_primary <- external_score_df %>%
  filter(
    !is.na(response_group_primary)
  )


cat("\nDistribución de la cohorte externa principal:\n")

print(
  table(
    external_primary$response_group_primary
  )
)


cat(
  "\nNúmero de pacientes incluidos en evaluación principal:",
  nrow(external_primary),
  "\n"
)


stopifnot(
  nrow(external_primary) == 13
)

stopifnot(
  sum(
    external_primary$response_group_primary ==
      "Responder"
  ) == 8
)

stopifnot(
  sum(
    external_primary$response_group_primary ==
      "NonResponder"
  ) == 5
)


############################################################
# 30. COMPARACIÓN PRINCIPAL DEL SCORE TRANSCRIPTÓMICO
#
# Evaluación externa principal:
#
# Responder    = CR / PR
# NonResponder = PD
# SD           = excluido
############################################################

# ----------------------------------------------------------
# Identificar outliers para su representación gráfica
#
# Se utiliza la regla estándar de Tukey:
# < Q1 - 1.5 × IQR
# > Q3 + 1.5 × IQR
#
# Los outliers se identifican únicamente con fines
# gráficos y NO se eliminan del análisis estadístico.
# ----------------------------------------------------------

external_primary_plot <- external_primary %>%
  group_by(response_group_primary) %>%
  mutate(
    Q1 = quantile(signature_score, 0.25, na.rm = TRUE),
    Q3 = quantile(signature_score, 0.75, na.rm = TRUE),
    IQR_score = IQR(signature_score, na.rm = TRUE),
    
    lower_limit = Q1 - 1.5 * IQR_score,
    upper_limit = Q3 + 1.5 * IQR_score,
    
    is_outlier =
      signature_score < lower_limit |
      signature_score > upper_limit
  ) %>%
  ungroup()


external_score_plot <- ggplot(
  external_primary_plot,
  aes(
    x = response_group_primary,
    y = signature_score
  )
) +
  
  # Líneas horizontales que marcan los extremos
  # de los bigotes
  stat_boxplot(
    geom = "errorbar",
    width = 0.15,
    linewidth = 0.5,
    color = "black"
  ) +
  
  # Boxplot sin mostrar automáticamente los outliers
  geom_boxplot(
    outlier.shape = NA,
    fill = "white",
    color = "black"
  ) +
  
  # Puntos normales con color según grupo
  geom_point(
    data = external_primary_plot %>%
      filter(!is_outlier),
    aes(
      color = response_group_primary
    ),
    size = 2.5,
    position = position_jitter(
      width = 0.12,
      height = 0,
      seed = 123
    )
  ) +
  
  # Outliers en rojo
  geom_point(
    data = external_primary_plot %>%
      filter(is_outlier),
    size = 2.5,
    color = "red",
    position = position_jitter(
      width = 0.12,
      height = 0,
      seed = 123
    )
  ) +
  
  # Mostrar valor únicamente de los outliers
  geom_text(
    data = external_primary_plot %>%
      filter(is_outlier),
    aes(
      label = round(signature_score, 2)
    ),
    color = "red",
    vjust = -1,
    size = 3.5,
    position = position_jitter(
      width = 0.12,
      height = 0,
      seed = 123
    )
  ) +
  
  # Colores de los puntos normales
  scale_color_manual(
    values = c(
      "NonResponder" = "#0072B2",
      "Responder" = "#009E73"
    )
  ) +
  
  scale_y_continuous(
    breaks = seq(-1, 3, by = 0.5),
    expand = expansion(
      mult = c(0.02, 0.05)
    )
  ) +
  
  coord_cartesian(
    ylim = c(-1, 3.1)
  ) +
  
  labs(
    title =
      "Evaluación externa principal de la firma transcriptómica",
    subtitle =
      "GSE145996: CR/PR vs PD",
    x =
      "Respuesta terapéutica",
    y =
      "Score transcriptómico"
  ) +
  
  theme_minimal() +
  
  theme(
    legend.position = "none"
  )


print(
  external_score_plot
)


external_score_test <- wilcox.test(
  signature_score ~ response_group_primary,
  data = external_primary,
  exact = FALSE
)


cat(
  "\nComparación externa principal del score:\n"
)

print(
  external_score_test
)


############################################################
# 31. EVALUACIÓN EXTERNA PRINCIPAL MEDIANTE ROC / AUC
#
# CR/PR vs PD
############################################################

external_primary <- external_primary %>%
  mutate(
    
    response_binary = ifelse(
      response_group_primary == "Responder",
      1,
      0
    )
    
  )


stopifnot(
  length(
    unique(
      external_primary$response_binary
    )
  ) == 2
)


roc_external <- pROC::roc(
  
  response =
    external_primary$response_binary,
  
  predictor =
    external_primary$signature_score,
  
  levels =
    c(0, 1),
  
  direction =
    "<",
  
  ci =
    TRUE,
  
  quiet =
    TRUE
)


external_auc <- pROC::auc(
  roc_external
)


external_auc_ci <- pROC::ci.auc(
  roc_external
)


cat(
  "\nAUC DE EVALUACIÓN EXTERNA PRINCIPAL:\n"
)

print(
  external_auc
)


cat(
  "\nIC 95% DEL AUC PRINCIPAL:\n"
)

print(
  external_auc_ci
)


plot(
  roc_external,
  main =
    "ROC externa principal - GSE145996: CR/PR vs PD"
)

text(
  x = 0.25,
  y = 0.10,
  labels = "AUC = 0,575 (IC95%: 0,199–0,951)",
  cex = 1
)

############################################################
# 32. ANÁLISIS DE SENSIBILIDAD
#
# Se evalúa una definición alternativa basada en respuesta
# objetiva:
#
# CR / PR -> Responder
# SD / PD -> NonResponder
#
# Este análisis incluye los 14 pacientes y NO sustituye
# la evaluación externa principal.
############################################################

external_sensitivity <- external_score_df %>%
  filter(
    !is.na(response_group_objective)
  )


cat(
  "\nDistribución del análisis de sensibilidad:\n"
)

print(
  table(
    external_sensitivity$response_group_objective
  )
)


cat(
  "\nNúmero de pacientes incluidos:",
  nrow(external_sensitivity),
  "\n"
)


stopifnot(
  nrow(external_sensitivity) == 14
)

############################################################
# 32.1. WILCOXON - ANÁLISIS DE SENSIBILIDAD
############################################################

sensitivity_wilcox <- wilcox.test(
  signature_score ~ response_group_objective,
  data = external_sensitivity,
  exact = FALSE
)


cat(
  "\nWilcoxon - sensibilidad CR/PR vs SD/PD:\n"
)

print(
  sensitivity_wilcox
)

############################################################
# 32.2. ROC / AUC - Análisis de sensibilidad
############################################################

external_sensitivity <- external_sensitivity %>%
  mutate(
    
    response_binary_sensitivity = ifelse(
      response_group_objective == "Responder",
      1,
      0
    )
    
  )

# Comprobar que existen las dos clases
stopifnot(
  length(
    unique(
      external_sensitivity$response_binary_sensitivity
    )
  ) == 2
)

roc_sensitivity <- pROC::roc(
  
  response =
    external_sensitivity$response_binary_sensitivity,
  
  predictor =
    external_sensitivity$signature_score,
  
  levels =
    c(0, 1),
  
  direction =
    "<",
  
  ci =
    TRUE,
  
  quiet =
    TRUE
)


auc_sensitivity <- pROC::auc(
  roc_sensitivity
)


auc_sensitivity_ci <- pROC::ci.auc(
  roc_sensitivity
)


cat(
  "\nAUC - análisis de sensibilidad:\n"
)

print(
  auc_sensitivity
)


cat(
  "\nIC 95% - análisis de sensibilidad:\n"
)

print(
  auc_sensitivity_ci
)


plot(
  roc_sensitivity,
  main =
    "ROC externa - sensibilidad CR/PR vs SD/PD"
)


