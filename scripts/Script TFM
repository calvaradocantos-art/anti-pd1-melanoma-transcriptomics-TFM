############################################################
# TFM: Biomarcadores transcriptómicos de respuesta anti-PD-1
# Dataset principal: GSE91061
# Dataset de evaluación de reproducibilidad y priorización: GSE78220
# Dataset de evaluación externa retrospectiva in silico: GSE145996
# Objetivo: preparar datos, analizar DEGs y priorizar candidatos
############################################################

############################################################
# 0. INSTALACIÓN Y CARGA DE PAQUETES
# Se cargan paquetes para descargar datos GEO, analizar RNA-seq,
# visualizar resultados y realizar enriquecimiento funcional.
############################################################

if (!requireNamespace("BiocManager", quietly = TRUE)) {
  install.packages("BiocManager")
}


# Instalar solo si no están previamente instalados
packages_bioc <- c(
  "GEOquery", "DESeq2", "AnnotationDbi",
  "org.Hs.eg.db", "clusterProfiler", "apeglm"
)

packages_cran <- c(
  "tidyverse", "pheatmap", "EnhancedVolcano", "readxl",
  "pROC", "rlang"
)

for (pkg in packages_bioc) {
  if (!requireNamespace(pkg, quietly = TRUE)) {
    BiocManager::install(pkg)
  }
}

for (pkg in packages_cran) {
  if (!requireNamespace(pkg, quietly = TRUE)) {
    install.packages(pkg)
  }
}

library(GEOquery)
library(DESeq2)
library(tidyverse)
library(pheatmap)
library(AnnotationDbi)
library(org.Hs.eg.db)
library(clusterProfiler)
library(EnhancedVolcano)
library(apeglm)
library(readxl)
library(pROC)
library(dplyr)
library(ggplot2)

############################################################
# 1. DESCARGA DE METADATOS DE GSE91061
# getGEO descarga los metadatos de la serie.
# En este dataset la matriz de expresión no viene cargada en exprs(eset),
# por eso se descargan archivos suplementarios con getGEOSuppFiles().
############################################################
            
gse <- getGEO("GSE91061", GSEMatrix = TRUE, getGPL = FALSE)
eset <- gse[[1]]
meta_raw <- pData(eset)

# Ver estructura general de metadatos
dim(meta_raw)
colnames(meta_raw)
head(meta_raw[, 1:6])

############################################################
# 2. DESCARGA Y LECTURA DE CONTEOS CRUDOS
# Para DESeq2 se usan conteos crudos, no FPKM ni TPM.
# row.names = 1 indica que la primera columna contiene IDs de genes.
############################################################

getGEOSuppFiles("GSE91061")

# Revisar archivos descargados
list.files("GSE91061", recursive = TRUE)

# Leer archivo de conteos crudos
counts <- read.csv(
  "GSE91061/GSE91061_BMS038109Sample.hg19KnownGene.raw.csv.gz",
  row.names = 1,
  check.names = FALSE
)

# Comprobar dimensiones y estructura
dim(counts)
head(rownames(counts))
head(colnames(counts))
counts[1:5, 1:5]

# Convertir a matriz
counts_mat <- as.matrix(counts)

# Verificar que todos los valores sean numéricos
stopifnot(is.numeric(counts_mat))

# Verificar que no existan NA
stopifnot(!anyNA(counts_mat))

# Verificar que los datos sean conteos enteros y no negativos
stopifnot(all(counts_mat >= 0))
stopifnot(all(counts_mat == round(counts_mat)))

# Solo después convertir explícitamente
storage.mode(counts_mat) <- "integer"

############################################################
# 3. ALINEACIÓN ENTRE CONTEOS Y METADATOS
# Las columnas de counts_mat deben coincidir con las filas de metadatos.
# En GSE91061 los nombres de las columnas suelen coincidir con meta_raw$title.
############################################################

sum(colnames(counts_mat) %in% meta_raw$title)
all(colnames(counts_mat) %in% meta_raw$title)

# Filtrar metadatos a muestras presentes en la matriz
meta_counts <- meta_raw[meta_raw$title %in% colnames(counts_mat), ]

# Reordenar metadatos para que coincidan con columnas de counts_mat
meta_counts <- meta_counts[match(colnames(counts_mat), meta_counts$title), ]

# Comprobación obligatoria
stopifnot(all(colnames(counts_mat) == meta_counts$title))

############################################################
# 4. INSPECCIÓN Y PREPARACIÓN INICIAL DE METADATOS CLÍNICOS
#
# En este apartado se inspecciona la estructura de los
# metadatos clínicos asociados a las muestras de GSE91061
# y se construye una tabla inicial para el análisis.
#
# Las columnas "characteristics" se exploran únicamente
# para conocer la información clínica disponible en GEO.
#
# Esta inspección es exploratoria y no determina
# automáticamente la variable utilizada como respuesta.
# La columna definitiva de respuesta clínica será definida
# y verificada explícitamente en el apartado 5.
############################################################

# ----------------------------------------------------------
# 4.1. Inspección de columnas de características clínicas
# ----------------------------------------------------------

char_cols <- grep(
  "characteristics",
  colnames(meta_counts),
  value = TRUE
)

cat("\nColumnas characteristics disponibles:\n")
print(char_cols)


# Mostrar una vista inicial
head(meta_counts[, char_cols,
    drop = FALSE
  ]
)


# ----------------------------------------------------------
# 4.2. Construcción de la tabla clínica inicial
#
# Se crea meta_clean a partir de los metadatos correspondientes
# a las muestras presentes en la matriz de conteos.
#
# sample_id permite identificar cada muestra.
# timepoint diferencia las muestras pretratamiento (Pre)
# de las obtenidas durante el tratamiento (On).
# ----------------------------------------------------------

meta_clean <- meta_counts %>%
  as.data.frame() %>%
  mutate(
    sample_id = title,
    timepoint = case_when(
      str_detect(title, "_Pre_") ~ "Pre",
      str_detect(title, "_On_")  ~ "On",
      TRUE ~ NA_character_
    )
  )


# ----------------------------------------------------------
# 4.4. Exploración del contenido clínico de characteristics
#
# Se muestran los valores únicos presentes en estas columnas
# para documentar la estructura de los metadatos clínicos.
#
# Esta exploración permite observar información como:
# - momento de obtención de la muestra;
# - respuesta clínica;
# - tipo de tejido.
#
# La variable de respuesta utilizada en el análisis será
# definida explícitamente en el apartado 5.
# ----------------------------------------------------------

for (cc in char_cols) {
  cat("\n\n---", cc, "---\n")
  print(unique(meta_clean[[cc]])[1:20])
}


############################################################
# 5. DEFINICIÓN DE LA RESPUESTA CLÍNICA
#
# Según Riaz et al. (2017), la respuesta al nivolumab se evaluó
# mediante RECIST v1.1 y se registró como mejor respuesta global.
#
# Para el análisis transcriptómico predictivo principal:
#
#   CR = Complete Response
#   PR = Partial Response
#   SD = Stable Disease
#   PD = Progressive Disease
#
# Clasificación utilizada en este TFM:
#
#   CR / PR  -> Responder
#   PD       -> NonResponder
#   SD       -> se conserva como categoría clínica,
#               pero se excluye del contraste binario principal.
#
# Esto permite reproducir conceptualmente la comparación
# pretratamiento CR/PR vs PD utilizada en el estudio original.
#
# Tras revisar la estructura completa de los metadatos de
# GSE91061 y verificar manualmente la información clínica,
# se identificó "response:ch1" como la columna que contiene
# la variable de respuesta utilizada en este análisis.
#
# La existencia de esta columna se comprueba antes de
# continuar con la recodificación.
############################################################

# ----------------------------------------------------------
# 5.1. Indicar la columna real de respuesta en GSE91061
# ----------------------------------------------------------

response_column <- "response:ch1"

# Comprobar que la columna realmente existe.
# Si no existe, el código se detendrá y evitará continuar
# con una clasificación clínica incorrecta.

stopifnot(response_column %in% colnames(meta_clean))


# ----------------------------------------------------------
# 5.2. Revisar primero los valores originales
# ----------------------------------------------------------

# Es importante observar cómo GEO escribió realmente las
# categorías antes de transformarlas.

cat("\nValores originales encontrados en la variable de respuesta:\n")

print(
  table(meta_clean[[response_column]], useNA = "ifany")
)


# ----------------------------------------------------------
# 5.3. Extraer CR/PR/SD/PD de los metadatos
# ----------------------------------------------------------

meta_clean <- meta_clean %>%
  mutate(
    
    # Conservamos el texto original exactamente como aparece
    # en GEO. Esto es útil para trazabilidad y para documentar
    # posteriormente cómo se realizó la recodificación.
    response_text = as.character(.data[[response_column]]),
    
    # Eliminamos espacios innecesarios.
    response_text = str_squish(response_text),
    
    # Eliminamos el prefijo "response:" si está presente.
    # Por ejemplo:
    #
    # "response: CR/PR" -> "CR/PR"
    # "response: SD"    -> "SD"
    # "response: PD"    -> "PD"
    #
    response_code = str_remove(
      response_text,
      regex("^response\\s*:\\s*", ignore_case = TRUE)
    ),
    
    # Convertimos todo a mayúsculas para evitar problemas
    # derivados de diferencias de escritura.
    response_code = str_to_upper(str_trim(response_code))
  )


# ----------------------------------------------------------
# 5.4. Normalizar las categorías clínicas reales de GSE91061
#
# IMPORTANTE:
# Se reconstruye response_code directamente desde response_text
# para evitar que una recodificación anterior haya convertido
# valores como PRCR en NA.
#
# Valores reales observados en GSE91061:
#
# PRCR = Complete Response / Partial Response
# SD   = Stable Disease
# PD   = Progressive Disease
# UNK  = respuesta desconocida
#
# Recodificación utilizada:
#
# PRCR -> CR/PR
# SD   -> SD
# PD   -> PD
# UNK  -> NA
# ----------------------------------------------------------

meta_clean <- meta_clean %>%
  mutate(
    
    # Volvemos a partir del dato clínico original
    response_original = str_to_upper(
      str_trim(
        str_remove(
          response_text,
          regex("^response\\s*:\\s*", ignore_case = TRUE)
        )
      )
    ),
    
    # Recodificación clínica
    response_code = case_when(
      
      response_original == "PRCR" ~ "CR/PR",
      
      response_original == "PD" ~ "PD",
      
      response_original == "SD" ~ "SD",
      
      response_original == "UNK" ~ NA_character_,
      
      TRUE ~ NA_character_
    )
  )

cat("\nValores originales recuperados:\n")

print(
  table(
    meta_clean$response_original,
    useNA = "ifany"
  )
)

# ----------------------------------------------------------
# 5.5. Comprobar las categorías clínicas obtenidas
# ----------------------------------------------------------

cat("\nCategorías clínicas después de la limpieza:\n")

print(
  table(
    meta_clean$response_code,
    useNA = "ifany"
  )
)



# ----------------------------------------------------------
# 5.6. Crear grupos para el análisis transcriptómico
#
# CR/PR -> Responder
# PD    -> NonResponder
# SD    -> excluido del contraste binario
# UNK   -> excluido por respuesta desconocida
# ----------------------------------------------------------

meta_clean <- meta_clean %>%
  mutate(
    response_group = case_when(
      
      response_code == "CR/PR" ~ "Responder",
      
      response_code == "PD" ~ "NonResponder",
      
      response_code == "SD" ~ NA_character_,
      
      TRUE ~ NA_character_
    )
  )


# ----------------------------------------------------------
# 5.7. Comprobar que la clasificación es correcta
# ----------------------------------------------------------

# Esta tabla es especialmente importante porque permite comprobar
# que ninguna categoría clínica fue asignada incorrectamente.

cat("\nCorrespondencia entre respuesta clínica y grupo analítico:\n")

print(
  table(
    meta_clean$response_code,
    meta_clean$response_group,
    useNA = "ifany"
  )
)


############################################################
# 6. SELECCIÓN DE LA COHORTE ANALÍTICA PRINCIPAL
#
# Se utilizarán exclusivamente muestras PRETRATAMIENTO.
#
# Justificación:
# queremos identificar perfiles transcriptómicos presentes
# antes de administrar nivolumab que puedan estar asociados
# con la respuesta posterior.
#
# Se excluyen:
#
# - muestras On-treatment
# - pacientes con SD para el contraste binario principal
# - muestras sin respuesta clínica definida
############################################################

# ----------------------------------------------------------
# 6.1. Obtener identificador del paciente
# ----------------------------------------------------------

# Los nombres de las muestras presentan formatos como:
#
# Pt1_Pre_AD101148-6
# Pt10_Pre_...
#
# Por ello extraemos "Pt1", "Pt10", etc.
#
# Esto permitirá contar PACIENTES y no solamente muestras.

meta_clean <- meta_clean %>%
  mutate(
    patient_id = str_extract(
      sample_id,
      regex("^Pt\\d+", ignore_case = TRUE)
    )
  )


# Comprobar que se pudo obtener patient_id
cat("\nNúmero de muestras sin identificador de paciente:\n")
print(sum(is.na(meta_clean$patient_id)))


# ----------------------------------------------------------
# 6.2. Revisar distribución completa antes de filtrar
# ----------------------------------------------------------

cat("\nRespuesta según momento de muestreo:\n")

print(
  table(
    meta_clean$timepoint,
    meta_clean$response_code,
    useNA = "ifany"
  )
)


# ----------------------------------------------------------
# 6.3. Seleccionar exclusivamente muestras Pre
#      y CR/PR frente a PD
# ----------------------------------------------------------

meta_final <- meta_clean %>%
  filter(
    timepoint == "Pre",
    response_code %in% c(
      "CR/PR",
      "PD"
    ),
    !is.na(response_group)
  )

# ----------------------------------------------------------
# 6.4. COMPROBAR CONSISTENCIA PACIENTE-RESPUESTA
#
# Se verifica que ningún paciente haya quedado asociado
# simultáneamente a Responder y NonResponder.
# ----------------------------------------------------------

patient_response_check <- meta_final %>%
  distinct(patient_id, response_group) %>%
  count(patient_id, name = "n_response_groups") %>%
  filter(n_response_groups > 1)

cat("\nPacientes asociados a más de un grupo de respuesta:\n")
print(patient_response_check)

# Si existe algún paciente con dos grupos distintos,
# el código se detiene porque sería una inconsistencia clínica.
stopifnot(nrow(patient_response_check) == 0)


# ----------------------------------------------------------
# 6.5. COMPROBAR CUÁNTOS PACIENTES QUEDAN
# ----------------------------------------------------------

# Primero contamos muestras.
# Esto NO necesariamente equivale al número de pacientes.

cat("\nNúmero de muestras por grupo:\n")

sample_summary <- meta_final %>%
  count(response_group, name = "n_samples")

print(sample_summary)


# Ahora contamos pacientes únicos.
# Esta es la cifra epidemiológica/analítica más importante.

cat("\nNúmero de pacientes únicos por grupo:\n")

patient_summary <- meta_final %>%
  distinct(patient_id, response_group) %>%
  count(response_group, name = "n_patients")

print(patient_summary)


# Número total de pacientes incluidos
cat("\nNúmero total de pacientes incluidos en el análisis:\n")

print(
  n_distinct(meta_final$patient_id)
)


# ----------------------------------------------------------
# 6.6. COMPROBAR SI ALGÚN PACIENTE TIENE MÁS DE UNA
#      MUESTRA PRETRATAMIENTO
#
# Esto es importante porque DESeq2 presupone observaciones
# independientes si no se modela explícitamente el paciente.
# ----------------------------------------------------------

duplicate_patients <- meta_final %>%
  count(patient_id, name = "n_pre_samples") %>%
  filter(n_pre_samples > 1)

cat("\nPacientes con más de una muestra Pre incluida:\n")

print(duplicate_patients)


if (nrow(duplicate_patients) > 0) {
  
  warning(
    "Existen pacientes con más de una muestra Pre. ",
    "Debe revisarse esta situación antes del análisis diferencial ",
    "para evitar tratar biopsias del mismo paciente como observaciones independientes."
  )
  
} else {
  
  cat(
    "\nCada paciente aporta una única muestra Pre al análisis principal.\n"
  )
}


# ----------------------------------------------------------
# 6.7. COMPROBAR QUE TODAS LAS MUESTRAS SE ENCUENTRAN
#      EN LA MATRIZ DE CONTEOS
# ----------------------------------------------------------

stopifnot(
  all(meta_final$sample_id %in% colnames(counts_mat))
)


# ----------------------------------------------------------
# 6.8. CREAR MATRIZ DE CONTEOS DEFINITIVA
# ----------------------------------------------------------

# Conservamos únicamente las columnas correspondientes a
# los pacientes seleccionados.

counts_final <- counts_mat[
  ,
  meta_final$sample_id,
  drop = FALSE
]


# ----------------------------------------------------------
# 6.9. DEFINIR LOS NOMBRES DE FILA DEL METADATA
# ----------------------------------------------------------

rownames(meta_final) <- meta_final$sample_id


# ----------------------------------------------------------
# 6.10. COMPROBACIÓN CRÍTICA DE CORRESPONDENCIA
# ----------------------------------------------------------
# DESeq2 exige que:
#
# columnas de countData
# =
# filas de colData
#
# y que además tengan exactamente el mismo orden.

stopifnot(
  all(
    colnames(counts_final) ==
      rownames(meta_final)
  )
)

cat(
  "\nCORRECTO: matriz de conteos y metadatos están perfectamente alineados.\n"
)


# ----------------------------------------------------------
# 6.11. CONVERTIR response_group EN FACTOR
# ----------------------------------------------------------
# NonResponder será el nivel de referencia.
#
# Por tanto, posteriormente:
# log2FoldChange > 0
# indicará mayor expresión en Respondedores
# cuando realicemos:
# Responder vs NonResponder

meta_final$response_group <- factor(
  meta_final$response_group,
  levels = c(
    "NonResponder",
    "Responder"
  )
)


# ----------------------------------------------------------
# 6.12. RESUMEN FINAL DE LA COHORTE
## ----------------------------------------------------------

cat("\n==============================\n")
cat("COHORTE FINAL PARA DESeq2\n")
cat("==============================\n\n")

cat(
  "Número de genes:",
  nrow(counts_final),
  "\n"
)

cat(
  "Número de muestras:",
  ncol(counts_final),
  "\n"
)

cat(
  "Número de pacientes:",
  n_distinct(meta_final$patient_id),
  "\n\n"
)

cat("Distribución final por grupo:\n")

print(
  table(meta_final$response_group)
)

cat("\nRespuesta clínica original:\n")

print(
  table(meta_final$response_code)
)

cat("\nMomento de muestreo:\n")

print(
  table(meta_final$timepoint)
)


############################################################
# 7. INSPECCIÓN INICIAL DE CALIDAD
#
# Se evalúa la estructura de la matriz de conteos antes del
# preprocesamiento y análisis diferencial.
#
# Se revisan:
# - dimensiones
# - valores NA
# - conteos negativos
# - proporción de ceros
# - tamaño de biblioteca por muestra
# - posibles muestras con comportamiento atípico
############################################################


# ----------------------------------------------------------
# 7.1. Comprobar dimensiones de la cohorte final
# ----------------------------------------------------------

dim(counts_final)

cat(
  "\nNúmero de genes antes del filtrado:",
  nrow(counts_final),
  "\n"
)

cat(
  "Número de muestras:",
  ncol(counts_final),
  "\n"
)


# ----------------------------------------------------------
# 7.2. Verificar integridad de los conteos
# ----------------------------------------------------------

stopifnot(!anyNA(counts_final))
stopifnot(all(counts_final >= 0))
stopifnot(all(counts_final == round(counts_final)))

cat("\nLos conteos son enteros, no negativos y sin NA.\n")


# ----------------------------------------------------------
# 7.3. Evaluar proporción global de ceros
# ----------------------------------------------------------

prop_zeros <- mean(counts_final == 0)

cat(
  "\nProporción global de ceros:",
  round(prop_zeros, 4),
  "\n"
)


# ----------------------------------------------------------
# 7.4. Evaluar proporción de ceros por muestra
# ----------------------------------------------------------

prop_zeros_sample <- colMeans(counts_final == 0)

summary(prop_zeros_sample)


# ----------------------------------------------------------
# 7.5. Calcular tamaño de biblioteca por muestra
# ----------------------------------------------------------

library_sizes <- colSums(counts_final)

summary(library_sizes)


# ----------------------------------------------------------
# 7.6. Crear tabla de control de calidad por muestra
# ----------------------------------------------------------

qc_samples <- data.frame(
  sample_id = colnames(counts_final),
  library_size = library_sizes,
  zero_fraction = prop_zeros_sample,
  response_group = meta_final$response_group
)

head(qc_samples)


# ----------------------------------------------------------
# 7.7. Visualizar tamaños de biblioteca
# ----------------------------------------------------------

barplot(
  library_sizes,
  las = 2,
  cex.names = 0.6,
  main = "Conteos totales por muestra - GSE91061 Pre",
  ylab = "Conteos totales"
)


# ----------------------------------------------------------
# 7.8. Visualizar distribución de tamaños de biblioteca
# ----------------------------------------------------------

boxplot(
  library_sizes,
  main = "Distribución de tamaños de biblioteca",
  ylab = "Conteos totales"
)


############################################################
# 8. FILTRADO DE GENES DE BAJA EXPRESIÓN
#
# Se eliminan genes con expresión insuficiente para reducir
# ruido estadístico y pruebas múltiples innecesarias.
#
# El número mínimo de muestras se determina según el tamaño
# del grupo analítico más pequeño.
############################################################


# ----------------------------------------------------------
# 8.1. Determinar tamaño del grupo más pequeño
# ----------------------------------------------------------

group_sizes <- table(meta_final$response_group)

group_sizes

min_group_size <- min(group_sizes)

cat(
  "\nTamaño del grupo más pequeño:",
  min_group_size,
  "\n"
)


# ----------------------------------------------------------
# 8.2. Definir criterio de filtrado
# ----------------------------------------------------------

# Se conserva un gen si presenta al menos 10 conteos
# en un número de muestras equivalente al grupo más pequeño.

keep <- rowSums(counts_final >= 10) >= min_group_size


# ----------------------------------------------------------
# 8.3. Aplicar filtrado
# ----------------------------------------------------------

counts_filt <- counts_final[keep, , drop = FALSE]


# ----------------------------------------------------------
# 8.4. Comparar antes y después
# ----------------------------------------------------------

cat(
  "\nGenes antes del filtrado:",
  nrow(counts_final),
  "\n"
)

cat(
  "Genes después del filtrado:",
  nrow(counts_filt),
  "\n"
)

cat(
  "Genes eliminados:",
  nrow(counts_final) - nrow(counts_filt),
  "\n"
)


# ----------------------------------------------------------
# 8.5. Verificar integridad de la matriz filtrada
# ----------------------------------------------------------

stopifnot(!anyNA(counts_filt))
stopifnot(all(counts_filt >= 0))
stopifnot(all(counts_filt == round(counts_filt)))

storage.mode(counts_filt) <- "integer"


############################################################
# 9. PREPARACIÓN DEL OBJETO DESEQ2
############################################################

# ----------------------------------------------------------
# 9.1. Confirmar nivel de referencia
# ----------------------------------------------------------

meta_final$response_group <- relevel(
  meta_final$response_group,
  ref = "NonResponder"
)

levels(meta_final$response_group)


# ----------------------------------------------------------
# 9.2. Crear objeto DESeq2
# ----------------------------------------------------------

dds <- DESeqDataSetFromMatrix(
  countData = counts_filt,
  colData = meta_final,
  design = ~ response_group
)

############################################################
# 10. TRANSFORMACIÓN VST Y ANÁLISIS PCA
#
# Objetivos:
# - estabilizar la varianza de los conteos
# - evaluar la estructura global de las muestras
# - detectar posibles outliers
# - observar si Responders y NonResponders presentan
#   patrones de agrupamiento globales
#
# IMPORTANTE:
# VST NO se utiliza para el análisis diferencial.
# DESeq2 trabaja con los conteos crudos contenidos en dds.
# VST se utiliza para análisis exploratorio y visualización.
############################################################


# ----------------------------------------------------------
# 10.1. Aplicar transformación estabilizadora de varianza
# ----------------------------------------------------------

# blind = TRUE hace que la transformación no utilice la
# información del diseño experimental.
#
# Es apropiado para explorar la estructura global de las
# muestras y detectar posibles anomalías sin forzar la
# separación según response_group.

vsd <- vst(
  dds,
  blind = TRUE
)


# Revisar el objeto generado
vsd


# ----------------------------------------------------------
# 10.2. Extraer matriz de expresión transformada
# ----------------------------------------------------------

vst_mat <- assay(vsd)

dim(vst_mat)

# Ver una pequeña parte
vst_mat[1:5, 1:5]


############################################################
# 10.3. COMPROBAR CORRESPONDENCIA CON LOS METADATOS
############################################################

stopifnot(
  all(
    colnames(vst_mat) ==
      rownames(meta_final)
  )
)

cat(
  "\nCORRECTO: matriz VST y metadatos están alineados.\n"
)


############################################################
# 10.4. PCA SEGÚN RESPONSE_GROUP
############################################################

# plotPCA calcula los componentes principales utilizando
# los genes con mayor variabilidad.
#
# returnData = TRUE permite recuperar los datos y construir
# una figura personalizada con ggplot2.

pca_data <- plotPCA(
  vsd,
  intgroup = "response_group",
  returnData = TRUE
)


# Porcentaje de varianza explicado por PC1 y PC2
percentVar <- round(
  100 * attr(pca_data, "percentVar"),
  1
)


# Revisar tabla PCA
head(pca_data)


############################################################
# 10.5. GRAFICAR PCA
############################################################

pca_plot <- ggplot(
  pca_data,
  aes(
    x = PC1,
    y = PC2,
    color = response_group
  )
) +
  geom_point(
    size = 3,
    alpha = 0.8
  ) +
  xlab(
    paste0(
      "PC1: ",
      percentVar[1],
      "% de varianza"
    )
  ) +
  ylab(
    paste0(
      "PC2: ",
      percentVar[2],
      "% de varianza"
    )
  ) +
  labs(
    title = "PCA de muestras pretratamiento - GSE91061",
    subtitle = "Respondedores vs NonRespondedores",
    color = "Respuesta"
  ) +
  theme_minimal()


print(pca_plot)


############################################################
# 10.6. PCA CON IDENTIFICADORES DE PACIENTE
#
# Se añaden etiquetas para identificar visualmente posibles
# muestras alejadas del resto.
############################################################

# Incorporar patient_id a los datos del PCA
pca_data$patient_id <- meta_final[
  rownames(pca_data),
  "patient_id"
]


pca_labels <- ggplot(
  pca_data,
  aes(
    PC1,
    PC2,
    color = response_group,
    label = patient_id
  )
) +
  geom_point(size = 3) +
  geom_text(
    vjust = -0.8,
    size = 3,
    check_overlap = TRUE
  ) +
  xlab(
    paste0(
      "PC1: ",
      percentVar[1],
      "% de varianza"
    )
  ) +
  ylab(
    paste0(
      "PC2: ",
      percentVar[2],
      "% de varianza"
    )
  ) +
  labs(
    title = "PCA con identificación de pacientes",
    color = "Respuesta"
  ) +
  theme_minimal()


print(pca_labels)


############################################################
# 11. EVALUACIÓN EXPLORATORIA DE POSIBLES OUTLIERS
#
# Se calcula la distancia de cada muestra respecto al centro
# de PC1 y PC2.
#
# Este análisis sirve para IDENTIFICAR muestras que merecen
# revisión, no para eliminarlas automáticamente.
############################################################

# ----------------------------------------------------------
# 11.1. Calcular distancia respecto al centro del PCA
# ----------------------------------------------------------

pc1_center <- median(
  pca_data$PC1,
  na.rm = TRUE
)

pc2_center <- median(
  pca_data$PC2,
  na.rm = TRUE
)


pca_data <- pca_data %>%
  mutate(
    pca_distance = sqrt(
      (PC1 - pc1_center)^2 +
        (PC2 - pc2_center)^2
    )
  )


# ----------------------------------------------------------
# 11.2. Ordenar muestras según distancia
# ----------------------------------------------------------

pca_outlier_check <- pca_data %>%
  arrange(desc(pca_distance)) %>%
  select(
    name,
    patient_id,
    response_group,
    PC1,
    PC2,
    pca_distance
  )


cat(
  "\nMuestras más alejadas del centro del PCA:\n"
)

print(
  head(
    pca_outlier_check,
    10
  )
)


# ----------------------------------------------------------
# 11.3. Combinar PCA con información de QC
#
# Se asume que qc_samples fue creado en el apartado 7.
# ----------------------------------------------------------

if (exists("qc_samples")) {
  
  pca_qc <- pca_outlier_check %>%
    rename(
      sample_id = name
    ) %>%
    left_join(
      qc_samples %>%
        select(
          sample_id,
          library_size,
          zero_fraction
        ),
      by = "sample_id"
    )
  
  cat(
    "\nPCA combinado con métricas de calidad:\n"
  )
  
  print(
    head(
      pca_qc,
      10
    )
  )
}


# ----------------------------------------------------------
# 11.4. DEFINICIÓN DEL DISEÑO ESTADÍSTICO FINAL
#
# Tras revisar PCA, QC y variables clínicas/técnicas,
# se establece el diseño definitivo antes de ejecutar
# el análisis diferencial.
# ----------------------------------------------------------

design(dds) <- ~ response_group

cat("\nDiseño estadístico final utilizado en DESeq2:\n")
print(design(dds))


############################################################
# 12. ANÁLISIS DE EXPRESIÓN DIFERENCIAL CON DESEQ2
#
# Una vez completada la evaluación exploratoria mediante
# VST/PCA y revisadas posibles muestras atípicas y factores
# de confusión, se ejecuta el modelo diferencial definitivo.
#
# El diseño final debe quedar establecido antes de ejecutar
# DESeq().
############################################################

# ----------------------------------------------------------
# 12.1. Ejecutar modelo de DESeq2
# ----------------------------------------------------------

dds <- DESeq(dds)


# ----------------------------------------------------------
# 12.2. Revisar nombres de coeficientes disponibles
# ----------------------------------------------------------

resultsNames(dds)


# ----------------------------------------------------------
# 12.3. Extraer contraste Responder vs NonResponder
# ----------------------------------------------------------

res_raw <- results(
  dds,
  contrast = c(
    "response_group",
    "Responder",
    "NonResponder"
  ),
  alpha = 0.05
)

# Conservar resultados sin shrinkage para análisis GSEA
# El estadístico de Wald se utilizará para ordenar los genes.

res_raw_df <- as.data.frame(res_raw) %>%
  rownames_to_column("ENTREZID")

# ----------------------------------------------------------
# 12.4. Aplicar shrinkage al log2 Fold Change
# ----------------------------------------------------------

# Confirmar previamente con resultsNames(dds) que este
# coeficiente existe exactamente con este nombre.

res <- lfcShrink(
  dds,
  coef = "response_group_Responder_vs_NonResponder",
  type = "apeglm"
)


# ----------------------------------------------------------
# 12.5. Convertir resultados en tabla
# ----------------------------------------------------------

res_df <- as.data.frame(res) %>%
  rownames_to_column("ENTREZID") %>%
  arrange(padj)

head(res_df)


# ----------------------------------------------------------
# 12.6. Añadir símbolos y nombres de genes
# ----------------------------------------------------------

res_df$SYMBOL <- mapIds(
  org.Hs.eg.db,
  keys = as.character(res_df$ENTREZID),
  column = "SYMBOL",
  keytype = "ENTREZID",
  multiVals = "first"
)

res_df$GENENAME <- mapIds(
  org.Hs.eg.db,
  keys = as.character(res_df$ENTREZID),
  column = "GENENAME",
  keytype = "ENTREZID",
  multiVals = "first"
)


# ----------------------------------------------------------
# 12.7. Definir genes diferencialmente expresados
# ----------------------------------------------------------

deg <- res_df %>%
  filter(
    !is.na(padj),
    padj < 0.05,
    abs(log2FoldChange) >= 1
  )


# ----------------------------------------------------------
# 12.8. Resumen de DEGs
# ----------------------------------------------------------

cat(
  "\nNúmero total de DEGs:",
  nrow(deg),
  "\n"
)

cat(
  "Sobreexpresados en Respondedores:",
  sum(deg$log2FoldChange > 0),
  "\n"
)

cat(
  "Sobreexpresados en NonRespondedores:",
  sum(deg$log2FoldChange < 0),
  "\n"
)

head(deg)


############################################################
# 13. VOLCANO PLOT
#
# Permite visualizar simultáneamente:
#
# eje X = log2FoldChange
# eje Y = significación estadística
############################################################


# ----------------------------------------------------------
# 13.1. Clasificar genes para interpretación
# ----------------------------------------------------------

res_df <- res_df %>%
  mutate(
    DEG_status = case_when(
      
      !is.na(padj) &
        padj < 0.05 &
        log2FoldChange >= 1
      ~ "Up_Responder",
      
      !is.na(padj) &
        padj < 0.05 &
        log2FoldChange <= -1
      ~ "Up_NonResponder",
      
      TRUE ~ "Not_significant"
    )
  )


# ----------------------------------------------------------
# 13.2. Crear etiquetas de genes
# ----------------------------------------------------------

res_df$gene_label <- ifelse(
  is.na(res_df$SYMBOL),
  res_df$ENTREZID,
  res_df$SYMBOL
)


# ----------------------------------------------------------
# 13.3. Volcano plot
# ----------------------------------------------------------

EnhancedVolcano(
  res_df,
  lab = res_df$gene_label,
  x = "log2FoldChange",
  y = "padj",
  pCutoff = 0.05,
  FCcutoff = 1,
  title = "Expresión diferencial pretratamiento",
  subtitle = "Responder vs NonResponder - GSE91061",
  caption = "padj < 0.05; |log2FC| >= 1"
)


############################################################
# 14. HEATMAP DE GENES DIFERENCIALMENTE EXPRESADOS
############################################################

# ----------------------------------------------------------
# 14.1. Comprobar que existan DEGs
# ----------------------------------------------------------

if (nrow(deg) > 0) {
  
  
# --------------------------------------------------------
# 14.2. Definir número de genes a visualizar
# --------------------------------------------------------
  
  n_heatmap <- min(
    30,
    nrow(deg)
  )
  
  
# --------------------------------------------------------
# 14.3. Seleccionar genes más significativos
# --------------------------------------------------------
  
 top_genes <- deg %>%
    arrange(padj) %>%
    slice_head(
      n = n_heatmap
    ) %>%
    pull(ENTREZID)
  
  
# --------------------------------------------------------
# 14.4. Extraer datos VST
# --------------------------------------------------------
  
  heatmap_mat <- vst_mat[
    top_genes,
    ,
    drop = FALSE
  ]
  
  
# --------------------------------------------------------
# 14.5. Estandarizar expresión por gen
#
# El Z-score permite comparar expresión relativa entre
# muestras para cada gen.
# --------------------------------------------------------
  
  heatmap_scaled <- t(
    scale(
      t(heatmap_mat)
    )
  )
  
  
# --------------------------------------------------------
# 14.6. Sustituir Entrez IDs por símbolos génicos
# --------------------------------------------------------
  
  symbol_lookup <- res_df$SYMBOL[
    match(
      rownames(heatmap_scaled),
      res_df$ENTREZID
    )
  ]
  
  
  rownames(heatmap_scaled) <- ifelse(
    is.na(symbol_lookup),
    rownames(heatmap_scaled),
    symbol_lookup
  )
  
  
# --------------------------------------------------------
# 14.7. Crear anotación clínica
# --------------------------------------------------------
  
  annotation_col <- data.frame(
    response_group =
      meta_final$response_group
  )
  
  rownames(annotation_col) <-
    rownames(meta_final)
  
  
# --------------------------------------------------------
# 14.8. Crear heatmap
# --------------------------------------------------------
  
  pheatmap(
    heatmap_scaled,
    annotation_col = annotation_col,
    show_colnames = FALSE,
    cluster_rows = TRUE,
    cluster_cols = TRUE,
    main = paste0(
      "Top ",
      n_heatmap,
      " DEGs - GSE91061"
    )
  )
  
  
} else {
  
  warning(
    "No se identificaron DEGs con los criterios establecidos. ",
    "No se generará heatmap."
  )
  
}


############################################################
# 15. ANÁLISIS FUNCIONAL DE LOS GENES DIFERENCIALMENTE
#     EXPRESADOS
#
# Objetivo:
# Evaluar la relevancia biológica de los DEGs identificados
# en GSE91061 mediante análisis de sobrerrepresentación.
#
# Se analizarán:
#
# 1. Todos los DEGs conjuntamente
# 2. DEGs sobreexpresados en Respondedores
# 3. DEGs sobreexpresados en NonRespondedores
#
# Bases utilizadas:
#
# - Gene Ontology Biological Process (GO-BP)
# - KEGG
#
# El universo de referencia estará constituido por todos los
# genes que superaron el filtrado de baja expresión y fueron,
# por tanto, elegibles para el análisis diferencial.
############################################################

