############################################################

# ----------------------------------------------------------
# 15.2.1. Todos los DEGs
# ----------------------------------------------------------

genes_all <- deg %>%
  filter(
    !is.na(ENTREZID)
  ) %>%
  pull(ENTREZID) %>%
  as.character() %>%
  unique()


# ----------------------------------------------------------
# 15.2.2. Genes sobreexpresados en Respondedores
#
# log2FoldChange > 0:
# mayor expresión en Respondedores.
# ----------------------------------------------------------

genes_responder <- deg %>%
  filter(
    !is.na(ENTREZID),
    log2FoldChange > 0
  ) %>%
  pull(ENTREZID) %>%
  as.character() %>%
  unique()


# ----------------------------------------------------------
# 15.2.3. Genes sobreexpresados en NonRespondedores
#
# log2FoldChange < 0:
# mayor expresión en NonRespondedores.
# ----------------------------------------------------------

genes_nonresponder <- deg %>%
  filter(
    !is.na(ENTREZID),
    log2FoldChange < 0
  ) %>%
  pull(ENTREZID) %>%
  as.character() %>%
  unique()


cat(
  "\nDEGs totales para enriquecimiento:",
  length(genes_all),
  "\n"
)

cat(
  "DEGs sobreexpresados en Respondedores:",
  length(genes_responder),
  "\n"
)

cat(
  "DEGs sobreexpresados en NonRespondedores:",
  length(genes_nonresponder),
  "\n"
)


############################################################
# 15.3. FUNCIÓN PARA ENRIQUECIMIENTO GO-BP
############################################################

run_GO <- function(gene_list, analysis_name) {
  
  # Si no existen genes suficientes, no ejecutar.
  if (length(gene_list) < 2) {
    
    warning(
      paste(
        "No existen suficientes genes para GO:",
        analysis_name
      )
    )
    
    return(NULL)
  }
  
  result <- enrichGO(
    
    gene = gene_list,
    
    universe = gene_universe,
    
    OrgDb = org.Hs.eg.db,
    
    keyType = "ENTREZID",
    
    ont = "BP",
    
    pAdjustMethod = "BH",
    
    pvalueCutoff = 0.05,
    
    qvalueCutoff = 0.05,
    
    readable = TRUE
  )
  
  
  cat(
    "\n==============================\n",
    "GO-BP:",
    analysis_name,
    "\n==============================\n"
  )
  
  
  result_df <- as.data.frame(result)
  
  
  if (nrow(result_df) > 0) {
    
    print(
      head(
        result_df,
        15
      )
    )
    
    print(
      dotplot(
        result,
        showCategory = 15
      ) +
        ggtitle(
          paste(
            "GO Biological Process -",
            analysis_name
          )
        )
    )
    
  } else {
    
    cat(
      "\nNo se encontraron términos GO-BP significativos.\n"
    )
  }
  
  
  return(result)
}


############################################################
# 15.4. FUNCIÓN PARA ENRIQUECIMIENTO KEGG
############################################################

run_KEGG <- function(gene_list, analysis_name) {
  
  if (length(gene_list) < 2) {
    
    warning(
      paste(
        "No existen suficientes genes para KEGG:",
        analysis_name
      )
    )
    
    return(NULL)
  }
  
  result <- enrichKEGG(
    
    gene = gene_list,
    
    universe = gene_universe,
    
    organism = "hsa",
    
    keyType = "ncbi-geneid",
    
    pAdjustMethod = "BH",
    
    pvalueCutoff = 0.05,
    
    qvalueCutoff = 0.05
  )
  
  
  cat(
    "\n==============================\n",
    "KEGG:",
    analysis_name,
    "\n==============================\n"
  )
  
  result_df <- as.data.frame(result)
  
  if (nrow(result_df) > 0) {
    
    print(
      head(
        result_df,
        15
      )
    )
    
    print(
      dotplot(
        result,
        showCategory = 15
      ) +
        ggtitle(
          paste(
            "KEGG -",
            analysis_name
          )
        )
    )
    
  } else {
    
    cat(
      "\nNo se encontraron vías KEGG significativas.\n"
    )
  }
  
  
  return(result)
}


